      step2_eyebrow: "We build",
      step2_name: "AI Engineering",
      guarantee: "Guarantee",
      step2_desc: 'We build the agents and the software, integrate them with your systems and train your team, in iterative sprints. First release in production in 4 weeks. <strong class="text-white">First month satisfied or refunded.</strong>',
      first_delivery: "First release",
      step2_metric: "4 wks",
      step2_items: [
        "AI agents live in production",
        "Integration with your systems",
        "Team training on the new flows",
        "Your code, full documentation",
        "30 days of post go-live hypercare",
      ],
      footer: 'The audit pins down the process to tackle and the measurable target; then the three dedicated people start on the first milestones, which <strong class="text-ink-900">you approve before we move on</strong>.',
      pricing_link: "See pricing",
      pricing_tail: ": three dedicated people, from 5,000 € per month, even for a single month.",
    },
    it: {
      eyebrow: "Da dove partire",
      title: "Da dove partire dipende da te.",
      subtitle: "Niente roadmap a 12 mesi, niente preventivi infiniti. Analisi dei processi in azienda oppure direttamente il primo sprint: decidi tu, e il primo mese è soddisfatti o rimborsati.",
      step1_eyebrow: "Punto di partenza",
      step1_name: "Analisi dei processi",
      step1_desc: "Quando uno schermo condiviso non basta, veniamo in azienda: intervistiamo le persone alla loro scrivania, osserviamo il lavoro com'è davvero e mappiamo i flussi sul campo. Ne escono le priorità giuste e un piano d'azione che il team riconosce come suo.",
      metric_label: "Formato",
      step1_metric: "In azienda",
      walk_away: "Cosa porti via",
      step1_items: [
        "Mappa dei tuoi flussi operativi reali",
        "Interviste alle persone che fanno il lavoro",
        "Priorità con l'impatto atteso di ciascuna",
        "Piano d'azione che il team riconosce come suo",
      ],
      step2_eyebrow: "Costruiamo",
      step2_name: "AI Engineering",
      guarantee: "Garanzia",
      step2_desc: 'Costruiamo gli agenti e il software, integriamo sui tuoi sistemi e formiamo il team, a sprint iterativi. Primo rilascio in produzione in 4 settimane. <strong class="text-white">Primo mese soddisfatti o rimborsati.</strong>',
      first_delivery: "Primo rilascio",
      step2_metric: "4 sett.",
      step2_items: [
        "Agenti IA live in produzione",
        "Integrazione con i tuoi sistemi",
        "Formazione del team sui nuovi flussi",
        "Codice tuo, documentazione completa",
        "30 giorni di hypercare post go-live",
      ],
      footer: "L'analisi fissa il processo da attaccare e il target misurabile; poi partono le tre persone dedicate con le prime milestone, che <strong class=\"text-ink-900\">approvi tu prima di proseguire</strong>.",
      pricing_link: "Vedi i prezzi",
      pricing_tail: ": tre persone dedicate, a partire da 5.000 € al mese, anche solo per un mese.",
    },
  },
  software: {
    en: {
      eyebrow: "Where to start",
      title: "Two steps. Clear scope. Your code.",
      subtitle: "No endless quotes, no 12-month projects. We start with clear scoping and decide together what to build, with a first release in a few weeks.",
      step1_eyebrow: "Starting point",
      step1_name: "Discovery & Scoping",
      step1_desc: "We get into your real processes: we map how you work today, define the functional spec and architecture, and hand you a concrete development plan with estimate and roadmap.",
      metric_label: "Duration",
      step1_metric: "1-2 wks",
      walk_away: "What you walk away with",
      step1_items: [
        "A map of the processes to digitalize",
        "Functional spec + technical architecture",
        "A sprint-based release roadmap",
        "A clear estimate of timeline and cost",
      ],
      step2_eyebrow: "We build",
      step2_name: "Build Sprint",
      guarantee: "Guarantee",
      step2_desc: 'We build in iterative sprints, integrate with your systems, ship to production, and train your team. First release in 4 weeks. <strong class="text-white">Your code from day one, first month satisfied or refunded.</strong>',
      first_delivery: "First release",
      step2_metric: "4 wks",
      step2_items: [
        "Web app / mobile / internal tools in production",
        "Integration with your systems (CRM, ERP, line-of-business)",
        "Your code and full documentation",
        "Iterative sprints with weekly demos",
