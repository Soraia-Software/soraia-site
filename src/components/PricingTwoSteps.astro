---
import SectionHeader from "./SectionHeader.astro";

interface Props {
  bg?: "white" | "ink-50";
  lang?: "it" | "en";
  variant?: "ai" | "software";
}
const { bg = "white", lang = "it", variant = "ai" } = Astro.props;

// Due modi di partire (analisi dei processi oppure direttamente il primo sprint),
// stesso modello di prezzo per entrambi: tre persone dedicate, da 5.000 € al mese.
const copy = {
  ai: {
    en: {
      eyebrow: "Where to start",
      title: "Where to start is up to you.",
      subtitle: "No 12-month roadmaps, no endless quotes. A process audit on site, or straight into the first sprint: you decide, and the first month is satisfied or refunded.",
      step1_eyebrow: "Starting point",
      step1_name: "Process audit",
      step1_desc: "When a shared screen is not enough, we come on site: we interview people at their desks, observe the work as it really happens and map the flows in the field. Out of it come the right priorities and an action plan your team recognises as its own.",
