---
// Scheda di un progetto (caso d'uso anonimo o case study con il nome) per le griglie di
// /settori/ e /casi-d-uso/. Copertina 16:9, chi è il cliente, cosa abbiamo fatto.
interface Props {
  href: string;
  immagine: string;
  srcset?: string;
  alt: string;
  etichetta: string;   // "Caso d'uso" o "Caso studio"
  perChi: string;
  titolo: string;
}
const { href, immagine, srcset, alt, etichetta, perChi, titolo } = Astro.props;
---

<a href={href} class="group flex flex-col rounded-2xl border border-line bg-white overflow-hidden no-underline transition-all hover:-translate-y-1 hover:shadow-md">
  <div class="relative aspect-[16/9] overflow-hidden" style="background: var(--color-ink-100);">
    <img
      src={immagine}
      srcset={srcset}
      sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
      alt={alt}
      width="960"
      height="540"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
    <span class="absolute left-3 top-3 text-[10.5px] font-medium tracking-[0.12em] uppercase px-2.5 py-1 rounded-full" style="background: rgba(255,255,255,0.92); color: var(--color-ink);">{etichetta}</span>
  </div>
  <div class="flex flex-col flex-1 p-6">
    <p class="text-[12.5px] leading-snug mb-2" style="color: var(--color-ink-soft);">{perChi}</p>
    <p class="font-medium text-[17px] leading-snug text-balance flex-1" style="color: var(--color-ink);">{titolo}</p>
    <span class="mt-4 inline-flex items-center gap-1.5 text-[13.5px] font-medium" style="color: var(--color-brand);">
      Leggi il progetto
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
    </span>
  </div>
</a>
