---
import { CLIENT_LOGOS_ROW_A, CLIENT_LOGOS_ROW_B, type ClientLogo as Logo } from "~/data/clientLogos";

interface Props {
  label: string;
  logos?: Logo[];     // selezione propria della pagina: una fila sola se corta, due se lunga
  rowA?: Logo[];      // prima fila, scorre da destra a sinistra: il primo logo si vede subito
  rowB?: Logo[];      // seconda fila, scorre da sinistra a destra, loghi diversi
}

// Senza props i loghi sono quelli canonici di src/data/clientLogos.ts, uguali su tutto il sito.
// Una lista propria corta (meno di 6) resta su una fila: divisa a metà si vedrebbero
// gli stessi due loghi ripetuti all'infinito.
const { label, logos, rowA, rowB } = Astro.props;
const SPLIT_FROM = 6;
let listA: Logo[];
let listB: Logo[];
if (rowA || rowB) {
  listA = rowA ?? [];
  listB = rowB ?? [];
} else if (logos && logos.length) {
  const half = logos.length >= SPLIT_FROM ? Math.ceil(logos.length / 2) : logos.length;
  listA = logos.slice(0, half);
  listB = logos.slice(half);
} else {
  listA = CLIENT_LOGOS_ROW_A;
  listB = CLIENT_LOGOS_ROW_B;
}

// Ogni fila è un marquee senza salti: la pista contiene il set due volte e trasla di -50%.
// Con pochi loghi il set viene ripetuto finché la metà pista copre la viewport.
const MIN_CELLS_PER_HALF = 8;
function buildTrack(list: Logo[]) {
  if (!list.length) return { half: [] as Logo[], doubled: [] as Logo[] };
  const reps = Math.max(1, Math.ceil(MIN_CELLS_PER_HALF / list.length));
  const h = Array.from({ length: reps }, () => list).flat();
  return { half: h, doubled: [...h, ...h] };
}
const A = buildTrack(listA);
const B = buildTrack(listB);
---

<section class="py-14 md:py-16 border-y border-ink-200 bg-white">
  <div class="container-soraia">
    <p class="text-[11px] font-medium uppercase tracking-[0.18em] text-ink-500 text-center mb-9">
      {label}
    </p>
  </div>

  <div class="pb-rows">
    <div class="pb-row">
      <div class="pb-track pb-track--left">
        {A.doubled.map((logo, idx) => (
          <div class="proofbar-cell shrink-0" aria-hidden={idx >= A.half.length ? "true" : undefined} title={logo.name}>
            {logo.src ? (
              <img src={logo.src} alt={logo.name} loading="lazy" decoding="async" class="logo-img" />
            ) : (
              <span class="text-xl md:text-2xl font-medium tracking-tight text-ink-400 whitespace-nowrap">{logo.name}</span>
            )}
          </div>
        ))}
      </div>
    </div>
    {B.doubled.length > 0 && (
      <div class="pb-row">
        <div class="pb-track pb-track--right">
          {B.doubled.map((logo, idx) => (
            <div class="proofbar-cell shrink-0" aria-hidden={idx >= B.half.length ? "true" : undefined} title={logo.name}>
              {logo.src ? (
                <img src={logo.src} alt={logo.name} loading="lazy" decoding="async" class="logo-img" />
              ) : (
                <span class="text-xl md:text-2xl font-medium tracking-tight text-ink-400 whitespace-nowrap">{logo.name}</span>
              )}
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style is:global>
  /* Due file in direzioni opposte, bordi sfumati */
  .pb-rows {
    display: flex; flex-direction: column; gap: 0.75rem; overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
  }
  .pb-row { overflow: hidden; }
  .pb-track { display: flex; width: max-content; will-change: transform; }
  .pb-track--left  { animation: pb-left 48s linear infinite; }
  .pb-track--right { animation: pb-right 56s linear infinite; }
  .pb-rows:hover .pb-track { animation-play-state: paused; }
  @keyframes pb-left  { from { transform: translateX(0); }    to { transform: translateX(-50%); } }
  @keyframes pb-right { from { transform: translateX(-50%); } to { transform: translateX(0); } }
  @media (prefers-reduced-motion: reduce) { .pb-track { animation: none; } }

  /* Uniform bounding box per logo: same visual real estate for square / wide / tall logos */
  .proofbar-cell {
    display: flex; align-items: center; justify-content: center;
    width: 150px; height: 60px; padding: 0 0.5rem; flex-shrink: 0;
  }
  @media (min-width: 768px) {
    .proofbar-cell { width: 170px; height: 64px; }
  }

  /* Logo image: fits within cell, max constraints both dimensions */
  .proofbar-cell .logo-img {
    max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain;
    filter: grayscale(100%) brightness(0.55) contrast(1.1);
    opacity: 0.75;
    transition: filter 0.4s var(--ease-out-quart), opacity 0.4s var(--ease-out-quart);
    mix-blend-mode: multiply;
  }

  /* Square / padded source images look small vs wide logos in a fixed cell. */
  .proofbar-cell .logo-img[src*="navily"],
  .proofbar-cell .logo-img[src*="storywonder"] {
    transform: scale(1.45);
    transform-origin: center;
  }
  .pb-rows:hover .proofbar-cell .logo-img,
  .proofbar-cell .logo-img:hover {
    filter: grayscale(0%) brightness(1);
    opacity: 1;
  }
</style>
