---
import "~/styles/globals.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import AskAIWidget from "~/components/AskAIWidget.astro";
import AnnouncementBar from "~/components/AnnouncementBar.astro";
import ConsentBanner from "~/components/ConsentBanner.astro";
import { localizePath, path as i18nPath, withSlash } from "~/lib/i18n";
import { ogImagePath } from "~/lib/og-path.mjs";
import { buildGraph, mainArticle } from "~/lib/schema";
// I due pesi di Inter che servono sopra la piega: con il preload partono insieme al CSS
// invece che dopo (prima arrivavano a 4,4 s su mobile).
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import inter500 from "@fontsource/inter/files/inter-latin-500-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  lang?: "it" | "en";
  jsonLd?: Record<string, any> | Record<string, any>[];
  /** Explicit URL of this page in the OTHER language. Pass on content detail
   *  pages whose slug differs across languages (guides, blog). When omitted,
   *  the alternate is derived from the path via localizePath(). */
  altHref?: string;
  /** Pages that exist in one language only (e.g. `/bandi`):
   *  hide the language switcher and skip the alternate-language hreflang. */
  hideLangSwitch?: boolean;
  /** Keep the page out of search engines (e.g. in-call sales tools). */
  noindex?: boolean;
  /** The page has no translation: keep the language switcher (it leads to `altHref`,
   *  e.g. the other blog index) but declare no hreflang alternate. */
  noAlternate?: boolean;
}

const {
  title,
  description,
  ogImage,
  canonical,
  lang = "it",
  jsonLd,
  altHref,
  hideLangSwitch = false,
  noindex = false,
  noAlternate = false,
} = Astro.props;

const siteUrl = "https://www.soraia.io";
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();

// hreflang alternates (it / en / x-default). Normalize to trailing slash so
// the alternates match the canonical convention (no duplicate-URL signals).
const otherLang = lang === "it" ? "en" : "it";
const otherPath = withSlash(altHref ?? localizePath(Astro.url.pathname, otherLang));
const itPath = withSlash(lang === "it" ? Astro.url.pathname : otherPath);
const enPath = withSlash(lang === "en" ? Astro.url.pathname : otherPath);
const itUrl = new URL(itPath, siteUrl).toString();
const enUrl = new URL(enPath, siteUrl).toString();
const contactHref = i18nPath("/parliamone", lang);

// Anteprima della pagina: la genera scripts/og-images.mjs dopo la build, con lo stesso nome.
const ogImageUrl = new URL(ogImage ?? ogImagePath(Astro.url.pathname), siteUrl).toString();
const graph = buildGraph(jsonLd, { url: canonicalUrl, lang, title, description, image: ogImageUrl });
const article = mainArticle(graph);
const rssHref = lang === "en" ? "/en/blog/rss.xml" : "/blog/rss.xml";
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- hreflang alternates -->
    <link rel="alternate" hreflang={lang} href={lang === "en" ? enUrl : itUrl} />
    {!hideLangSwitch && !noAlternate && <link rel="alternate" hreflang={lang === "en" ? "it" : "en"} href={lang === "en" ? itUrl : enUrl} />}
    <link rel="alternate" hreflang="x-default" href={noAlternate && lang === "en" ? enUrl : itUrl} />
    <link rel="alternate" type="application/rss+xml" title={lang === "en" ? "Soraia blog" : "Blog di Soraia"} href={rssHref} />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content="Soraia" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === "it" ? "it_IT" : "en_US"} />
    {!hideLangSwitch && !noAlternate && <meta property="og:locale:alternate" content={lang === "it" ? "en_US" : "it_IT"} />}
    {article?.datePublished && <meta property="article:published_time" content={article.datePublished} />}
    {article?.dateModified && <meta property="article:modified_time" content={article.dateModified} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Theme -->
    <meta name="theme-color" content="#4A1E5C" />

    <!-- Geo (registered office, Biella) -->
    <meta name="geo.region" content="IT-BI" />
    <meta name="geo.placename" content="Biella" />
    <meta name="geo.position" content="45.5648864;8.0542568" />
    <meta name="ICBM" content="45.5648864, 8.0542568" />

    <!-- Fonts self-hosted via @fontsource (importati in globals.css), niente CDN Google -->
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter500} as="font" type="font/woff2" crossorigin />

    <!-- Icone: .ico per i client che lo cercano alla radice, SVG per i browser, PNG per iOS -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Un solo @graph: WebSite, Organization, WebPage e i nodi della pagina (src/lib/schema.ts) -->
    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, "\\u003c")} />
    <!-- First-touch attribution: capture utm_* + external referrer + landing page once
         per visitor (90-day window) so a lead can be traced to the channel that brought
         them. Read by LeadForm at submit; stored on the lead in D1. -->
    <script is:inline>
      (function () {
        try {
          var KEY = "soraia_attr", MAXAGE = 90 * 864e5;
          var cur = null;
          try { cur = JSON.parse(localStorage.getItem(KEY) || "null"); } catch (e) {}
          if (cur && cur.ts && Date.now() - cur.ts < MAXAGE) return; // keep first-touch
          var p = new URLSearchParams(location.search);
          var g = function (k) { return (p.get(k) || "").slice(0, 120); };
          var ref = "";
          try { if (document.referrer && new URL(document.referrer).hostname !== location.hostname) ref = document.referrer; } catch (e) {}
          localStorage.setItem(KEY, JSON.stringify({
            utm_source: g("utm_source"), utm_medium: g("utm_medium"), utm_campaign: g("utm_campaign"),
            utm_content: g("utm_content"), utm_term: g("utm_term"),
            referrer: ref.slice(0, 300), landing_page: (location.pathname + location.search).slice(0, 300),
            ts: Date.now()
          }));
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <!-- email_off: niente offuscamento delle email di Cloudflare. Senza JavaScript (crawler IA
         compresi) info@soraia.io diventava «[email protected]» con un link 404 in ogni pagina. -->
    <!--email_off-->
    {lang === "it" && (
      <AnnouncementBar
        text="Bandi aperti per digitalizzare la tua azienda."
        ctaText="Trova quelli della tua regione"
        ctaHref="/bandi/"
        dismissId="bandi-2026"
      />
    )}
    <Header lang={lang} altHref={otherPath} hideLangSwitch={hideLangSwitch} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Sticky AI ask widget, bottom-right su tutte le pagine -->
    <AskAIWidget lang={lang} />

    <!-- Consenso per il visitor tracking di lemlist: lo script parte solo dopo «Accetta» -->
    <ConsentBanner lang={lang} />

    <!-- Sticky mobile CTA bottom, visible only on mobile, hidden when /parliamone is the current path -->
    <!-- Parte nascosta: in cima alla pagina c'è già la CTA dell'hero (prima all'apertura se ne
         vedevano due uguali sovrapposte). Compare scorrendo verso l'alto, come prima. -->
    <div id="sticky-cta" class="md:hidden fixed bottom-0 left-0 right-0 z-40 px-4 pb-3 pt-2 transition-transform duration-300" style="transform: translateY(110%); background: linear-gradient(180deg, rgba(250,250,248,0) 0%, rgba(250,250,248,0.95) 30%, #FAFAF8 100%);">
      <a href={contactHref} class="btn btn-primary w-full !justify-center shadow-lg">
        {lang === "en" ? "20 min with Daniel" : "20 min con Daniel"}
        <span class="btn-arrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </span>
      </a>
    </div>

    <script is:inline>
      // Hide sticky CTA on /parliamone (already showing form)
      (function() {
        const cta = document.getElementById("sticky-cta");
        if (!cta) return;
        const p = window.location.pathname;
        if (p.startsWith("/parliamone") || p.startsWith("/en/contact")) {
          cta.style.display = "none";
          return;
        }
        // Hide on scroll down past hero, show again on scroll up
        let lastY = window.scrollY;
        let visible = false;
        window.addEventListener("scroll", () => {
          const y = window.scrollY;
          if (y < 200) {
            // Near top: hide (hero CTAs visible)
            if (visible) { cta.style.transform = "translateY(110%)"; visible = false; }
          } else if (y > lastY + 20) {
            // scrolling down fast: hide
            if (visible) { cta.style.transform = "translateY(110%)"; visible = false; }
          } else if (y < lastY - 20) {
            // scrolling up: show
            if (!visible) { cta.style.transform = "translateY(0)"; visible = true; }
          }
          lastY = y;
        }, { passive: true });
      })();
    </script>

    <script>
      // Refined scroll-triggered reveal
      if (typeof window !== "undefined" && "IntersectionObserver" in window) {
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!reduced) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("in-view");
                  io.unobserve(entry.target);
                }
              });
            },
            { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
          );
          document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
        } else {
          document.querySelectorAll(".reveal").forEach((el) => el.classList.add("in-view"));
        }
      }
    </script>
    <!--/email_off-->
  </body>
</html>
