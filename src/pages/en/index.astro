---
import Layout from "~/layouts/Layout.astro";
import SectionHeader from "~/components/SectionHeader.astro";
import ProofBar from "~/components/ProofBar.astro";
import WorldMap from "~/components/WorldMap.astro";
import CTABanner from "~/components/CTABanner.astro";
import HeroVisual from "~/components/HeroVisual.astro";
import FAQ from "~/components/FAQ.astro";
import PartnersStrip from "~/components/PartnersStrip.astro";
import AskAISection from "~/components/AskAISection.astro";
import CaseStudyCarousel from "~/components/CaseStudyCarousel.astro";
import { getCollection } from "astro:content";

// Fetch featured + most recent case studies, map to the Jet card format.
const allCases = (await getCollection("caseStudies")).filter((c) => c.data.lang === "en" && !c.data.draft);
const photoMap: Record<string, string> = {
  "40factory": "/testimonials/margherita-chifari-40factory.webp",
  aegis: "/testimonials/aegis_vittorio_maiani.webp",
  apraise: "/testimonials/jacopo-castano-apraise.webp",
  cxl: "/testimonials/brian-dandelet-cxl.webp",
  frh: "/testimonials/fabricio-carminati-frh.webp",
  liftt: "/testimonials/alberto-burzio-liftt.webp",
  navily: "/testimonials/edouard-fiess-navily.webp",
  numeraria: "/testimonials/elisa-gnan-numeraria.webp",
  "oggi-lavoro": "/testimonials/francesca-sorrentino-oggi-lavoro.webp",
  rainplan: "/testimonials/amanda-potter-rainplan.webp",
  "stars-be-original": "/testimonials/gabriella-bruzzone-stars.webp",
  "startup-govtech": "/testimonials/govtech-startup.webp",
  storywonder: "/testimonials/rolf-storywonder.webp",
  "talent-match": "/testimonials/guillem-llacuna-talent-match.webp",
};
const carouselItems = allCases
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.pubDate.getTime() - a.data.pubDate.getTime();
  })
  .slice(0, 9)
  .map((c) => ({
    slug: c.id.replace(/^en\//, ""),
    client: c.data.client,
    clientLogo: c.data.clientLogo,
    quote: c.data.shortQuote || c.data.heroQuote.slice(0, 140) + (c.data.heroQuote.length > 140 ? "…" : ""),
    dimensioni: c.data.dimensioni,
    sector: c.data.sector,
    cardImage: c.data.cardImage || photoMap[c.id.replace(/^en\//, "")],
  }));

const title = "Soraia. We Bring AI Agents to Italian SMEs";
const description =
  "We bring order to your SME's processes and automate them with custom software and AI agents that stay yours. Process audit and AI Engineering, from €8,000/month with three dedicated people. First month satisfied or refunded.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.soraia.io/#organization",
  name: "Soraia",
  legalName: "Soraia S.r.l.",
  url: "https://www.soraia.io",
  logo: "https://www.soraia.io/logos/soraia-full.svg",
  description,
  email: "info@soraia.io",
  vatID: "IT02820060024",
  foundingDate: "2023",
  numberOfEmployees: { "@type": "QuantitativeValue", minValue: 10 },
  knowsAbout: ["Business process audit", "AI agents", "AI Engineering", "Process automation for SMEs"],
  address: {
    "@type": "PostalAddress",
    streetAddress: "Via Losana 13",
    addressLocality: "Biella",
    postalCode: "13900",
    addressRegion: "BI",
    addressCountry: "IT",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 45.5648864,
    longitude: 8.0542568,
  },
  areaServed: ["IT", "EU"],
  founder: [
    { "@type": "Person", name: "Daniel Levis", jobTitle: "CEO" },
    { "@type": "Person", name: "Davide Silvestri", jobTitle: "CTO" },
  ],
  sameAs: ["https://www.linkedin.com/company/soraia-digital"],
};

// Client logos (two files, order decided on 2026-10-17) live in src/data/clientLogos.ts:
// ProofBar reads them on its own, so every page shows the same bar.

const partners = [
  // LLM & AI providers
  { name: "Anthropic", src: "/logos/tools/anthropic.svg" },
  { name: "OpenAI", src: "/logos/tools/openai.svg" },
  { name: "Mistral", src: "/logos/tools/mistral.svg" },
  { name: "Google", src: "/logos/tools/google.svg" },
  // Automation
  { name: "Make", src: "/logos/tools/make.svg" },
  { name: "n8n", src: "/logos/tools/n8n.svg" },
  { name: "Zapier", src: "/logos/tools/zapier.svg" },
  // CRM & business tools
  { name: "HubSpot", src: "/logos/tools/hubspot.svg" },
  { name: "Salesforce", src: "/logos/tools/salesforce.svg" },
  { name: "Pipedrive", src: "/logos/tools/pipedrive.svg" },
  // Productivity & collab
  { name: "Slack", src: "/logos/tools/slack.svg" },
  { name: "Microsoft", src: "/logos/tools/microsoft.svg" },
  { name: "Notion", src: "/logos/tools/notion.svg" },
  { name: "Airtable", src: "/logos/tools/airtable.svg" },
  { name: "Dropbox", src: "/logos/tools/dropbox.svg" },
  { name: "Asana", src: "/logos/tools/asana.svg" },
  // Dev & infra
  { name: "GitHub", src: "/logos/tools/github.svg" },
  { name: "AWS", src: "/logos/tools/aws.svg" },
  { name: "Cloudflare", src: "/logos/tools/cloudflare.svg" },
  // No-code / backend
  { name: "Xano", src: "/logos/tools/xano.webp" },
  { name: "WeWeb", src: "/logos/tools/weweb.svg" },
  // Commerce & ops
  { name: "Stripe", src: "/logos/tools/stripe.svg" },
  { name: "Shopify", src: "/logos/tools/shopify.svg" },
  { name: "Mailchimp", src: "/logos/tools/mailchimp.svg" },
  { name: "Calendly", src: "/logos/tools/calendly.svg" },
];


// Regional dots. Europe grouped, other regions individual
const worldRegions = [
  {
    x: 50.5, y: 36,
    label: "Europe",
    flag: "🇪🇺",
    total: 28,
    countries: [
      { flag: "🇮🇹", name: "Italy", count: 12 },
      { flag: "🇨🇭", name: "Switzerland", count: 3 },
      { flag: "🇫🇷", name: "France", count: 3 },
      { flag: "🇬🇧", name: "UK", count: 3 },
      { flag: "🇪🇸", name: "Spain", count: 2 },
      { flag: "🇳🇱", name: "Netherlands", count: 2 },
      { flag: "🇩🇪", name: "Germany", count: 2 },
      { flag: "🇵🇹", name: "Portugal", count: 1 },
    ],
    align: "right" as const,
  },
  {
    x: 23, y: 40,
    label: "United States",
    flag: "🇺🇸",
    total: 7,
    countries: [
      { flag: "🇺🇸", name: "USA", count: 7 },
    ],
    align: "left" as const,
  },
  {
    x: 60, y: 49,
    label: "UAE",
    flag: "🇦🇪",
    total: 4,
    countries: [
      { flag: "🇦🇪", name: "UAE", count: 4 },
    ],
  },
  {
    x: 84, y: 71,
    label: "Australia",
    flag: "🇦🇺",
    total: 2,
    countries: [
      { flag: "🇦🇺", name: "Australia", count: 2 },
    ],
    align: "right" as const,
  },
];

const faqs = [
  {
    q: "What does Soraia do in 30 seconds?",
    a: "We're an <strong>Italian AI agency</strong> for SMEs: we bring order to your processes and automate them with custom software and AI agents that remain your property. Two services: a <strong>process audit</strong> (we come on site, map the work as it really happens and leave you with priorities and an action plan) and <strong>AI Engineering</strong> (sprint-based development, first release in production in 4 weeks). First month satisfied or refunded.",
  },
  {
    q: "How much does it cost to get started?",
    a: "<strong>From €8,000/month</strong>, VAT excluded, with a Sprint: <strong>three dedicated people</strong> on your project, an Account Manager, a Project Manager and an AI Engineer, and one release in production every month, even for a single month. The Compliance &amp; Audit and Pentest add-ons, €4,000 each one-off, bring documentation for your DPO and legal team on GDPR and the AI Act, and an external pentest. Build your path on the <a href='/en/pricing' style='color: var(--color-brand); text-decoration: underline;'>pricing page</a>.",
  },
  {
    q: "Who is this for?",
    a: "<strong>Italian SMEs and teams of 10 to 200 people</strong> in sectors where repetitive processes consume most of the team's time: recruitment, accounting firms, marketing, customer ops, real estate, financial services. If your team spends more than 30% of its time on repetitive tasks, we have something for you.",
  },
  {
    q: "How quickly will we see results?",
    a: "<strong>4 weeks from kick-off to the first release in production</strong>, on your real processes. From there we continue in sprints, one release at a time, and you approve every milestone before we move on. If you start with the process audit, within a few weeks you have the process map, the priorities and the action plan.",
  },
  {
    q: "What does the first step look like?",
    a: "We start with a <strong>free 20-minute call</strong> with Daniel, the CEO: no pitch, just figuring out whether it makes sense to work together. Daniel, Veronica and Paolo reply within 24 hours. Then you decide where to start: from the on-site process audit, or straight into the first sprint if you already know what to build. Milestones and releases are the obligation of result: you approve them.",
  },
];
---

<Layout title={title} description={description} lang="en" jsonLd={jsonLd}>
  <!-- ============================================================
       1. HERO DEEP PURPLE
       ============================================================ -->
  <section class="relative overflow-hidden bg-hero-dark">

    <div class="container-soraia pt-16 md:pt-24 pb-20 md:pb-28 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-20 items-center min-h-[60vh]">
        <!-- Left: copy -->
        <div class="text-white max-w-2xl">
          <p class="inline-flex items-center gap-2 text-[11px] font-medium tracking-[0.15em] uppercase text-violet-200 mb-6 fade-up">
            <span class="w-1 h-1 rounded-full bg-amber"></span>
            AI Agency · Italy · Global clients
          </p>

          <h1 class="text-white text-balance fade-up fade-up-delay-1" style="font-size: clamp(2.5rem, 5vw + 1rem, 4.25rem); line-height: 1.05; letter-spacing: -0.025em; font-weight: 500;">
            We bring AI&nbsp;Agents<br/>to Italian SMEs.
          </h1>

          <p class="mt-7 text-[18px] md:text-[19px] text-violet-100/85 leading-relaxed max-w-xl fade-up fade-up-delay-2 text-pretty">
            AI agents that run your processes end-to-end, rather than software your team has to learn. First delivery in 4 weeks.
          </p>

          <!-- HARD NUMBERS BAND, upfront credibility -->
          <div class="mt-8 grid grid-cols-3 gap-3 max-w-xl fade-up fade-up-delay-2">
            <div>
              <p class="text-white font-medium" style="font-size: clamp(1.5rem, 2.5vw + 0.5rem, 2rem); line-height: 1; letter-spacing: -0.02em;">70%</p>
              <p class="text-[12px] text-violet-200/70 mt-2 leading-snug">average time recovered<br/>per process</p>
            </div>
            <div>
              <p class="text-white font-medium" style="font-size: clamp(1.5rem, 2.5vw + 0.5rem, 2rem); line-height: 1; letter-spacing: -0.02em;">40+</p>
              <p class="text-[12px] text-violet-200/70 mt-2 leading-snug">projects<br/>delivered</p>
            </div>
            <div>
              <p class="text-white font-medium" style="font-size: clamp(1.5rem, 2.5vw + 0.5rem, 2rem); line-height: 1; letter-spacing: -0.02em;">4 wks</p>
              <p class="text-[12px] text-violet-200/70 mt-2 leading-snug">to the first<br/>agent live</p>
            </div>
          </div>

          <!-- GUARANTEE BADGE -->
          <div class="mt-7 inline-flex items-center gap-2 fade-up fade-up-delay-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#F4B842" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L4 6v6c0 5 3.5 9.5 8 10 4.5-.5 8-5 8-10V6l-8-4z"/><path d="M9 12l2 2 4-4"/>
            </svg>
            <span class="text-[14px] text-amber font-medium">First month satisfied or refunded.</span>
          </div>

          <!-- CTA + CEO CHIP -->
          <div class="mt-9 flex flex-col sm:flex-row gap-3 fade-up fade-up-delay-3">
            <a href="/en/contact" class="btn btn-primary !bg-white !text-violet-900 hover:!bg-violet-50">
              20 min with Daniel
              <span class="btn-arrow">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </span>
            </a>
            <a href="#where-to-start" class="btn btn-secondary !bg-transparent !text-white !border-white/25 hover:!bg-white/10 hover:!border-white/40">
              See the solutions
            </a>
          </div>

          <!-- WHO REPLIES: the Account Managers, Daniel, Veronica and Paolo (the team faces are further down) -->
          <a href="/en/contact" class="mt-8 inline-flex items-center gap-4 text-[13px] leading-tight no-underline group fade-up fade-up-delay-4">
            <span class="flex items-center flex-shrink-0">
              <img src="/team/daniel-levis.webp?v=4" alt="Daniel Levis" loading="eager" width="56" height="56" class="w-14 h-14 rounded-full object-cover ring-2 ring-[#1A0820] flex-shrink-0" />
              <img src="/team/veronica-pisana.webp?v=4" alt="Veronica Pisana" loading="eager" width="56" height="56" class="w-14 h-14 rounded-full object-cover ring-2 ring-[#1A0820] flex-shrink-0 -ml-4" />
              <img src="/team/paolo-bacchetti.webp?v=4" alt="Paolo Bacchetti" loading="eager" width="56" height="56" class="w-14 h-14 rounded-full object-cover ring-2 ring-[#1A0820] flex-shrink-0 -ml-4" />
            </span>
            <span class="block">
              <span class="block text-white font-medium text-[14px]">Daniel, Veronica and Paolo reply within 24 hours.</span>
              <span class="block mt-1 text-violet-200/70">Soraia Account Managers</span>
            </span>
          </a>
        </div>

        <!-- Right: visual -->
        <div class="lg:justify-self-end w-full fade-up fade-up-delay-2">
          <HeroVisual lang="en" />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2. TRUSTED BY, proof bar + featured-in
       ============================================================ -->
  <ProofBar label="Trusted by" />

  <!-- ============================================================
       2a-bis. SME POSITIONING, tech background + grid, team faces
       ============================================================ -->
  <section class="section bg-tech-grid relative overflow-hidden">
    <div class="container-soraia">
      <div class="max-w-3xl mx-auto text-center">
        <p class="eyebrow mb-5">For growing SMEs</p>
        <h2 class="text-balance font-medium tracking-tight" style="font-size: clamp(1.875rem, 3vw + 0.5rem, 3rem); line-height: 1.1; color: var(--color-ink);">
          The ideal solution for Italian SMEs.
        </h2>
        <p class="mt-5 text-[17px] md:text-[18px] leading-relaxed text-pretty mx-auto max-w-2xl" style="color: var(--color-ink-muted);">
          Built for companies without an in-house team of AI engineers, who know that putting AI agents to work opens doors: more time taken back from repetitive processes, fewer errors, operations that scale. We bring the team and the method, you get the results.
        </p>
      </div>

      <div class="mt-11 flex flex-col items-center gap-4">
        <div class="flex items-center">
          {["daniel-levis", "eleonora-cogo", "lorenzo-barbaglia", "veronica-pisana", "davide-silvestri", "martina-rochstein", "mohamed-mejri"].map((slug, i) => (
            <img src={`/team/${slug}.webp?v=4`} alt="" loading="lazy" width="44" height="44" class={`w-11 h-11 rounded-full object-cover border-2 border-white ${i === 0 ? "" : "-ml-3"}`} style="box-shadow: var(--shadow-sm);" />
          ))}
        </div>
        <p class="text-[15px] md:text-[16px] font-medium text-center" style="color: var(--color-ink);">
          We're a team of people who know how an SME works.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2b. TWO WAYS TO START, routing by the client's situation
       ============================================================ -->
  <section id="where-to-start" class="section bg-white">
    <div class="container-soraia">
      <SectionHeader
        title="Where to start is up to you."
        subtitle="Some companies already know what to automate. Others know they want to, but not where to begin. Each has a precise starting point."
        align="center"
      />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto">
        <!-- A: Development -->
        <div class="card-editorial reveal !p-8 md:!p-10 flex flex-col">
          <span class="text-[13px] font-semibold text-ink-500 mb-4">AI engineering</span>
          <h3 class="font-medium tracking-tight leading-[1.12] text-ink-900 mb-3" style="font-size: clamp(1.4rem, 2vw + 0.4rem, 1.9rem);">
            You already know what you want
          </h3>
          <p class="text-[16px] text-ink-700 leading-relaxed text-pretty mb-7 flex-1">
            You know which processes to automate and where artificial intelligence adds value. You've already spotted the bottlenecks. We build the solutions in iterative sprints.
          </p>
          <a href="/en/ai-engineering" class="btn btn-ghost btn-arrow self-start !px-0" style="color: var(--color-brand);">
            Discover AI engineering
            <span class="btn-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span>
          </a>
        </div>

        <!-- B: Process audit (highlighted) -->
        <div class="card-editorial reveal reveal-delay-1 !p-8 md:!p-10 flex flex-col" style="border: 2px solid var(--color-brand); background: var(--color-violet-50, #FDF4FF);">
          <span class="text-[13px] font-semibold mb-4" style="color: var(--color-brand-accent);">Process audit</span>
          <h3 class="font-medium tracking-tight leading-[1.12] text-ink-900 mb-3" style="font-size: clamp(1.4rem, 2vw + 0.4rem, 1.9rem);">
            You want to use AI, but don't know where to start
          </h3>
          <p class="text-[16px] text-ink-700 leading-relaxed text-pretty mb-7 flex-1">
            First we understand how you really work, then we decide what to build. The audit pinpoints where automation and AI bring the most value, before you spend on development.
          </p>
          <a href="/en/process-audit" class="btn btn-primary btn-arrow self-start">
            Discover the process audit
            <span class="btn-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2c. AFTER WE STEP IN, outcomes / benefits
       ============================================================ -->
  <section class="section bg-hero-dark relative overflow-hidden">
    <div class="container-soraia relative z-10">
      <SectionHeader
        eyebrow="After we step in"
        title="A company with lower operating costs, that depends less on you and is worth more."
        subtitle="We bring order to your processes and automate them with custom software and AI agents, which remain your company's property."
        align="center"
        variant="dark"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-7 max-w-5xl mx-auto">
        <div class="dk-card reveal">
          <span class="dk-chip">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </span>
          <h3 class="font-medium tracking-tight mb-2.5" style="font-size: 1.3rem; color: #fff;">Lower operating costs</h3>
          <p class="text-[15.5px] leading-relaxed" style="color: rgba(255,255,255,0.75);">Data entry, checks, reconciliations and reports are handled by the software. The same people manage more volume and the company grows without growing its back office.</p>
        </div>
        <div class="dk-card reveal reveal-delay-1">
          <span class="dk-chip">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>
          </span>
          <h3 class="font-medium tracking-tight mb-2.5" style="font-size: 1.3rem; color: #fff;">You're no longer the bottleneck</h3>
          <p class="text-[15.5px] leading-relaxed" style="color: rgba(255,255,255,0.75);">Clear processes can be delegated. Routine tasks no longer go through you, the company gains a proper management layer and you go back to leading it instead of chasing it.</p>
        </div>
        <div class="dk-card reveal">
          <span class="dk-chip">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </span>
          <h3 class="font-medium tracking-tight mb-2.5" style="font-size: 1.3rem; color: #fff;">Hire better, train faster</h3>
          <p class="text-[15.5px] leading-relaxed" style="color: rgba(255,255,255,0.75);">Give people the modern tools the new generations expect. With documented processes, onboarding gets shorter and know-how stays in the company, even when a key person leaves.</p>
        </div>
        <div class="dk-card reveal reveal-delay-1">
          <span class="dk-chip">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          </span>
          <h3 class="font-medium tracking-tight mb-2.5" style="font-size: 1.3rem; color: #fff;">More value when the handover comes</h3>
          <p class="text-[15.5px] leading-relaxed" style="color: rgba(255,255,255,0.75);">Whether you sell or pass the company on to your children, what counts is how well it runs without you. Documented processes, tidy data and software you own make it more solid and easier to hand over.</p>
        </div>
      </div>
    </div>
    <!-- .dk-card / .dk-chip live in globals.css (shared with the about page "What drives us") -->
  </section>

  <!-- ============================================================
       2c-bis. YOU ALWAYS KNOW WHO YOU'RE DEALING WITH, the people of the journey
       ============================================================ -->
  <section class="section bg-violet-mesh border-t border-line">
    <div class="container-soraia">
      <div class="max-w-2xl mb-12 md:mb-14">
        <p class="eyebrow mb-5">Always the same people</p>
        <h2 class="text-balance font-medium tracking-tight" style="font-size: clamp(1.75rem, 3vw + 0.5rem, 2.5rem); line-height: 1.12; color: var(--color-ink);">
          A journey that never starts from scratch.
        </h2>
        <p class="mt-5 text-[17px] md:text-[18px] leading-relaxed text-pretty" style="color: var(--color-ink-muted);">
