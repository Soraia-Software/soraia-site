---
import Layout from "~/layouts/Layout.astro";
import SectionHeader from "~/components/SectionHeader.astro";
import WorldMap from "~/components/WorldMap.astro";
import FAQ from "~/components/FAQ.astro";
import CTABanner from "~/components/CTABanner.astro";

const title = "About us, Italian AI Agency for SMEs | Soraia";
const description = "A 100% remote team of more than 10 people distributed across Italy. 40+ projects delivered, focus on Italian SMEs, no technology lock-in.";

// Founder education/experience logos: put official files in
// src/assets/logos/experience/<slug>.{svg,png,webp,avif}. Missing files fall
// back to the institution name (no broken images).
const expLogos = import.meta.glob("/src/assets/logos/experience/*.{svg,png,webp,avif}", { eager: true, query: "?url", import: "default" }) as Record<string, string>;
const slugify = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
function logoFor(name: string): string | null {
  const slug = slugify(name);
  for (const [p, url] of Object.entries(expLogos)) {
    if ((p.split("/").pop() || "").replace(/\.[^.]+$/, "") === slug) return url;
  }
  return null;
}

const valueIcons: Record<string, string> = {
