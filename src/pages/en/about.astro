---

<Layout title={title} description={description} lang="en">

  <!-- ============================================================
       HERO
       ============================================================ -->
  <section class="relative overflow-hidden bg-violet-mesh">
    <div class="container-soraia pt-20 md:pt-28 pb-16 md:pb-20">
      <div class="text-center max-w-3xl mx-auto">
        <p class="inline-flex items-center gap-2 text-[11px] font-medium tracking-[0.15em] uppercase mb-6" style="color: var(--color-ink-soft);">
          <span class="w-1 h-1 rounded-full" style="background: var(--color-brand);"></span>
          About us
        </p>
        <h1 class="text-balance" style="font-size: clamp(2.25rem, 5vw + 1rem, 4rem); line-height: 1.05; letter-spacing: -0.025em; font-weight: 500;">
          Behind Soraia there are real people.
        </h1>
        <p class="mt-6 text-[17px] md:text-[18px] leading-relaxed text-pretty max-w-2xl mx-auto" style="color: var(--color-ink-muted);">
          More than 10 people across Italy, 100% remote. Plus a few AI agents that work with us every day, like one more colleague.
        </p>
      </div>

      <!-- events / retreat marquee: slow horizontal loop to reveal all photos -->
      <div class="events-marquee mt-12 md:mt-16" aria-label="Soraia team moments and retreats">
        <div class="em-row em-row--a">
          {[...eventsRowA, ...eventsRowA].map((e, i) => (
            <img src={e.src} alt={i < eventsRowA.length ? e.caption : ""} aria-hidden={i >= eventsRowA.length ? "true" : undefined} loading="lazy" decoding="async" />
          ))}
        </div>
        <div class="em-row em-row--b">
          {[...eventsRowB, ...eventsRowB].map((e, i) => (
            <img src={e.src} alt={i < eventsRowB.length ? e.caption : ""} aria-hidden={i >= eventsRowB.length ? "true" : undefined} loading="lazy" decoding="async" />
          ))}
        </div>
      </div>
    </div>

    <script>
      // Team mosaic: every ~2.4 s a random tile slides in a person (or an AI agent) not currently
      // in view, pushing the current one out. Direction per tile (data-dir: x horizontal,
      // y vertical). With prefers-reduced-motion it stays still.
      const root = document.querySelector<HTMLElement>("[data-team-mosaic]");
      if (root) {
        type P = { slug: string; name: string; role: string; src: string; agent?: boolean };
        const pool: P[] = JSON.parse(root.dataset.pool || "[]");
        const slots = Array.from(root.querySelectorAll<HTMLElement>("[data-mosaic-slot]"));
        const current = slots.map((s) => s.dataset.slug || "");
        pool.forEach((p) => { const im = new Image(); im.src = p.src; });
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const reflow = (el: HTMLElement) => void el.offsetWidth;
        if (!reduce && slots.length && pool.length > slots.length) {
          let last = -1;
          let busy = false;
          window.setInterval(() => {
            if (busy || document.hidden) return;
            let i = Math.floor(Math.random() * slots.length);
            if (i === last) i = (i + 1) % slots.length;
            last = i;
            const slot = slots[i];
            const candidates = pool.filter((p) => !current.includes(p.slug));
            const next = candidates[Math.floor(Math.random() * candidates.length)];
            if (!next) return;
            const imgs = Array.from(slot.querySelectorAll<HTMLImageElement>(".tm-img"));
            const on = imgs.find((im) => im.classList.contains("is-on")) || imgs[0];
            const off = imgs.find((im) => im !== on) || imgs[1];
            busy = true;
            const slide = () => {
              // the new one starts from the entry position without animation, then slides in
              off.classList.add("no-anim");
              off.classList.remove("is-out");
              reflow(off);
              off.classList.remove("no-anim");
              off.alt = next.name;
              off.removeAttribute("aria-hidden");
              window.requestAnimationFrame(() => {
                off.classList.add("is-on");
                on.classList.remove("is-on");
                on.classList.add("is-out");
                on.setAttribute("aria-hidden", "true");
                const name = slot.querySelector(".tm-name");
                const role = slot.querySelector(".tm-role");
                if (name) name.textContent = next.name;
                if (role) role.textContent = next.role;
                slot.classList.toggle("is-agent", !!next.agent);
                slot.dataset.slug = next.slug;
                current[i] = next.slug;
              });
              window.setTimeout(() => {
                // the old one goes back to the entry position, ready for the next round
                on.classList.add("no-anim");
                on.classList.remove("is-out");
                reflow(on);
                on.classList.remove("no-anim");
                busy = false;
              }, 800);
            };
            off.onload = slide;
            off.src = next.src;
            if (off.complete && off.naturalWidth > 0) { off.onload = null; slide(); }
          }, 2400);
        }
      }
    </script>

    <style is:global>
      /* Founder education/experience logo strip (used in the "Founders" section) */
      .exp-logo { height: 28px; width: auto; max-width: 88px; object-fit: contain; flex: 0 1 auto; min-width: 0; }
      /* Team mosaic ("Work with us" band): bento of rounded square tiles, sliding images */
      .team-mosaic { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .tm-tile { position: relative; overflow: hidden; border-radius: 18px; aspect-ratio: 1 / 1; background: #1A0820; box-shadow: 0 10px 30px rgba(0,0,0,0.35); }
      .tm-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 18%; transform: translateX(102%); transition: transform .7s cubic-bezier(.22,.61,.36,1); will-change: transform; }
      .tm-tile[data-dir="y"] .tm-img { transform: translateY(102%); }
      .tm-tile .tm-img.is-on { transform: none; }
      .tm-tile .tm-img.is-out { transform: translateX(-102%); }
      .tm-tile[data-dir="y"] .tm-img.is-out { transform: translateY(-102%); }
      .tm-tile .tm-img.no-anim { transition: none; }
      .tm-cap { position: absolute; left: 10px; bottom: 10px; display: flex; flex-direction: column; gap: 1px; padding: 6px 10px; border-radius: 10px; background: rgba(26, 8, 32, 0.55); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); color: #fff; line-height: 1.2; max-width: calc(100% - 20px); transition: background .4s ease; }
      .tm-name { font-size: 12.5px; font-weight: 600; letter-spacing: -0.01em; }
      .tm-role { font-size: 11px; color: rgba(255, 255, 255, 0.78); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .tm-tile.is-agent .tm-cap { background: rgba(137, 45, 156, 0.72); }
      @media (min-width: 1024px) {
        .team-mosaic { grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(4, 1fr); aspect-ratio: 1 / 1; gap: 12px; }
        .tm-tile { aspect-ratio: auto; }
        .tm-a { grid-column: 1 / 3; grid-row: 1 / 3; }
        .tm-b { grid-column: 3 / 5; grid-row: 1 / 3; }
        .tm-c { grid-column: 1 / 3; grid-row: 3 / 5; }
        .tm-d { grid-column: 3 / 4; grid-row: 3 / 5; }
        .tm-e { grid-column: 4 / 5; grid-row: 3 / 4; }
        .tm-f { grid-column: 4 / 5; grid-row: 4 / 5; }
        .tm-e .tm-role, .tm-f .tm-role { display: none; }
        .tm-d .tm-cap, .tm-e .tm-cap, .tm-f .tm-cap { left: 8px; bottom: 8px; padding: 5px 8px; }
        .tm-d .tm-name, .tm-e .tm-name, .tm-f .tm-name { font-size: 11.5px; line-height: 1.15; }
      }
      @media (prefers-reduced-motion: reduce) { .tm-tile .tm-img { transition: none; } }
      /* Events marquee (hero): two rows scrolling slowly in a loop, opposite directions */
      .events-marquee {
        display: flex; flex-direction: column; gap: 14px; overflow: hidden;
        -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
        mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
      }
      .em-row { display: flex; width: max-content; will-change: transform; }
      .em-row img {
        height: clamp(140px, 19vw, 220px); width: auto; flex: 0 0 auto; margin-right: 14px;
        border-radius: 14px; object-fit: cover; box-shadow: var(--shadow-sm);
        background: var(--color-ink-100); -webkit-user-drag: none; user-select: none;
      }
      .em-row--a { animation: em-marquee-left 70s linear infinite; }
      .em-row--b { animation: em-marquee-right 88s linear infinite; }
      .events-marquee:hover .em-row { animation-play-state: paused; }
      @keyframes em-marquee-left { from { transform: translateX(0); } to { transform: translateX(-50%); } }
      @keyframes em-marquee-right { from { transform: translateX(-50%); } to { transform: translateX(0); } }
      @media (prefers-reduced-motion: reduce) { .em-row { animation: none; } }
    </style>
  </section>


  <!-- ============================================================
       WORK WITH US, dedicated band (big box to apply)
       ============================================================ -->
  <section class="section bg-hero-dark relative overflow-hidden">
    <div class="container-soraia relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <div class="lg:col-span-6">
          <p class="eyebrow eyebrow-light mb-5">Work with us</p>
          <h2 class="text-balance" style="color: #fff; font-size: clamp(2rem, 3.2vw + 0.5rem, 3rem); line-height: 1.08; letter-spacing: -0.025em; font-weight: 500;">
            We're growing. Join the team.
          </h2>
          <p class="mt-5 text-[17px] md:text-[18px] leading-relaxed text-pretty max-w-xl" style="color: rgba(255,255,255,0.8);">
            We're looking for people who want to build AI agents that companies actually use. Small team, 100% remote, real autonomy. The selection has four steps, no surprises.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="/careers/" class="btn !bg-white !text-violet-900 hover:!bg-violet-50">
              Apply
              <span class="btn-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span>
            </a>
            <a href="/careers/#processo" class="btn btn-secondary !bg-transparent !text-white !border-white/25 hover:!bg-white/10 hover:!border-white/40">How the selection works</a>
          </div>
        </div>
        <!-- team mosaic: rounded square tiles sliding in a loop; the AI agents show up among the people -->
        <div class="lg:col-span-6">
          <div class="team-mosaic" data-team-mosaic data-pool={JSON.stringify(mosaicPool)} aria-label="The Soraia team, people and AI agents">
            {mosaicSlots.map((slot) => {
              const p = mosaicPool.find((m) => m.slug === slot.slug)!;
              return (
                <figure class={`tm-tile tm-${slot.area}${p.agent ? " is-agent" : ""}`} data-mosaic-slot data-slug={p.slug} data-dir={slot.dir} style="margin: 0;">
                  <img class="tm-img is-on" src={p.src} alt={p.name} width="480" height="600" loading="lazy" decoding="async" />
                  <img class="tm-img" alt="" aria-hidden="true" width="480" height="600" decoding="async" />
                  <figcaption class="tm-cap"><span class="tm-name">{p.name}</span><span class="tm-role">{p.role}</span></figcaption>
                </figure>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       FOUNDERS
       ============================================================ -->
  <section class="section bg-violet-mesh border-y border-line">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="The founders"
        title="Daniel and Davide."
        subtitle="Co-founders since 2023, with complementary profiles: commercial & change management on one side, tech leadership & AI engineering on the other. Background in high-level consulting and tech scaleups."
        align="center"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-6xl mx-auto">
        {founders.map((f) => (
          <article class="card-editorial !p-8 md:!p-10 flex flex-col">
            <div class="flex items-center gap-5 mb-7">
              <div class="w-20 h-20 md:w-24 md:h-24 shrink-0 rounded-2xl overflow-hidden bg-ink-50 ring-1 ring-violet-100">
                <img src={f.photo} alt={f.name} loading="lazy" width="96" height="96" class="w-full h-full object-cover" />
              </div>
              <div>
                <h3 style="font-size: 1.375rem; line-height: 1.2; letter-spacing: -0.02em; font-weight: 500; color: var(--color-ink);">{f.name}</h3>
                <p class="mt-1 text-[14px]" style="color: var(--color-ink-soft);">{f.role}</p>
              </div>
            </div>
            <p class="text-[15px] leading-relaxed text-pretty flex-1" style="color: var(--color-ink-muted);">{f.bio}</p>
            <div class="mt-7 pt-6 border-t border-line space-y-3">
              <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
                <p class="text-[10px] font-medium tracking-[0.14em] uppercase w-[78px] flex-shrink-0" style="color: var(--color-ink-soft);">Education</p>
                {f.education.map((e) => {
                  const url = logoFor(e);
                  return url
                    ? <img src={url} alt={e} title={e} class="exp-logo" loading="lazy" />
                    : <span class="text-[13px] font-medium" style="color: var(--color-ink);">{e}</span>;
                })}
              </div>
              <div class="flex flex-nowrap items-center gap-x-2.5">
                <p class="text-[10px] font-medium tracking-[0.14em] uppercase w-[78px] flex-shrink-0" style="color: var(--color-ink-soft);">Experience</p>
                {f.companies.map((c) => {
                  const url = logoFor(c);
                  return url
                    ? <img src={url} alt={c} title={c} class="exp-logo" loading="lazy" />
                    : <span class="text-[13px] font-medium" style="color: var(--color-ink);">{c}</span>;
                })}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       VALUES
       ============================================================ -->
  <section class="section bg-hero-dark relative overflow-hidden">
    <div class="container-soraia relative z-10">
      <SectionHeader
        eyebrow="What drives us"
        title="The principles that hold us together."
        subtitle="Six values we use to make hard decisions: when to say no to a project, when to add or remove an agent, how to communicate with the client. Operational criteria, more than slogans."
        align="center"
        variant="dark"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6 max-w-6xl mx-auto">
        {values.map((v, i) => (
          <div class={`dk-card reveal${i % 3 === 1 ? " reveal-delay-1" : i % 3 === 2 ? " reveal-delay-2" : ""}`}>
            <span class="dk-chip">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={valueIcons[v.icon]} />
            </span>
            <h3 class="font-medium tracking-tight text-balance" style="font-size: 1.2rem; line-height: 1.25; color: #fff;">{v.title}</h3>
            <p class="mt-2.5 text-[15px] leading-relaxed text-pretty" style="color: rgba(255,255,255,0.75);">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       HOW WE WORK
       ============================================================ -->
  <section class="section bg-tech-grid border-t border-line">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="How we work"
        title="Fully remote by default. On-site when the value demands it."
        subtitle="Day-to-day delivery is 100% remote: no corporate offices, no inflated costs landing in the quote. When an in-person meeting is what's needed, we come to you."
        align="center"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-5xl mx-auto">
        <article class="card-editorial !p-8 md:!p-9">
          <div class="w-11 h-11 rounded-lg flex items-center justify-center mb-6" style="background: var(--color-brand-soft); color: var(--color-brand);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <h3 class="text-balance" style="font-size: 1.25rem; line-height: 1.25; letter-spacing: -0.02em; font-weight: 500; color: var(--color-ink);">
            100% remote delivery
          </h3>
          <p class="mt-3 text-[14.5px] leading-relaxed text-pretty" style="color: var(--color-ink-muted);">
            Build, deploy, hypercare, and post-go-live support are all managed remotely. Tools designed for async collaboration, no pointless calls. Team distributed across Italy, covering the full working day.
          </p>
        </article>

        <article class="card-editorial !p-8 md:!p-9">
          <div class="w-11 h-11 rounded-lg flex items-center justify-center mb-6" style="background: var(--color-brand-soft); color: var(--color-brand);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3 class="text-balance" style="font-size: 1.25rem; line-height: 1.25; letter-spacing: -0.02em; font-weight: 500; color: var(--color-ink);">
            On-site when it counts
          </h3>
          <p class="mt-3 text-[14.5px] leading-relaxed text-pretty" style="color: var(--color-ink-muted);">
            <strong style="color: var(--color-ink); font-weight: 500;">Process audit</strong>: when a shared screen is not enough, we come on site. We interview people at their desks, observe how the work really happens and map the flows in the field. That is where the right priorities come from, along with an action plan the team recognises as its own.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================================
       GLOBAL REACH
       ============================================================ -->
  <section class="section bg-violet-mesh border-y border-line">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="Global reach"
        title="Italian company. Clients worldwide."
        subtitle="Team <strong>full-remote based in Italy</strong>, but we work with <strong>40+ clients</strong> distributed across Europe, the United States, the UAE, and Australia."
        align="center"
      />

      <WorldMap regions={worldRegions} />

      <!-- Region breakdown row -->
      <div class="mt-2 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 max-w-3xl mx-auto text-[13px]" style="color: var(--color-ink-muted);">
        {worldRegions.map((r, i) => (
          <>
            {i > 0 && <span style="color: var(--color-ink-soft); opacity: 0.6;">·</span>}
            <span class="inline-flex items-center gap-2">
              <span class="text-[14px] leading-none">{r.flag}</span>
              <span><strong style="color: var(--color-ink); font-weight: 500;">{r.total}</strong> {r.label}</span>
            </span>
          </>
        ))}
      </div>

      <div class="mt-14 grid grid-cols-3 gap-px bg-ink-200 rounded-3xl overflow-hidden max-w-4xl mx-auto reveal">
        <div class="bg-white p-7 md:p-9 text-center">
          <p class="text-[2.5rem] md:text-[3.5rem] font-medium tracking-tight leading-none" style="color: var(--color-brand);">40+</p>
          <p class="mt-3 text-[13px] font-medium text-ink-900">Projects delivered</p>
        </div>
        <div class="bg-white p-7 md:p-9 text-center">
          <p class="text-[2.5rem] md:text-[3.5rem] font-medium tracking-tight leading-none" style="color: var(--color-brand);">10+</p>
          <p class="mt-3 text-[13px] font-medium text-ink-900">People, distributed across Italy</p>
        </div>
        <div class="bg-white p-7 md:p-9 text-center">
          <p class="text-[2.5rem] md:text-[3.5rem] font-medium tracking-tight leading-none" style="color: var(--color-brand);">4 wks.</p>
          <p class="mt-3 text-[13px] font-medium text-ink-900">To first live agent</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       FAQ
       ============================================================ -->
  <section class="section bg-white">
    <div class="container-soraia max-w-4xl">
      <SectionHeader
        eyebrow="Frequently asked questions"
        title="What people usually ask us."
        align="center"
      />
      <FAQ items={faqs} />
    </div>
  </section>

  <!-- ============================================================
       FINAL CTA
       ============================================================ -->
  <CTABanner
    title="20 minutes with the CEO. No pitch."
    description="We figure out together whether it makes sense to work together. No commitment, no surprise quotes: just an operational conversation about your processes."
    ctaText="20 min with Daniel"
    ctaHref="/en/contact"
    avatarName="Daniel Levis"
    avatarRole="Co-Founder & CEO"
    avatarSrc="/team/daniel-levis.webp"
  />
