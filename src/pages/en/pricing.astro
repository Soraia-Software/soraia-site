---
import Layout from "~/layouts/Layout.astro";
import PathBuilder from "~/components/PathBuilder.tsx";
import SectionHeader from "~/components/SectionHeader.astro";
import FAQ from "~/components/FAQ.astro";
import "~/styles/prezzi.css";

const title = "Pricing | Soraia";
const description =
  "A team that brings to life the software you need. Analysis €3,000, Sprint €5,000 a month, Hypercare from €500, plus the add-ons you need: Compliance & Audit, Pentest, Training. Fixed price, one release every month.";

const faqs = [
  {
    q: "Why is the Analysis paid?",
    a: "Because it is real work: you come out of it with a blueprint, priorities and a fixed-price quote, and it stays yours even if you decide not to go on. If you start a Sprint within 30 days, the €3,000 is deducted. It is not compulsory: if you already know what to build, you start straight from the Sprint.",
  },
  {
    q: "What exactly is included in a month of Sprint?",
    a: "The dedicated team, the method and a release in production. What to build we define together in the Sprint Goal at the start of the month: it is the document that says what arrives.",
  },
  {
    q: "Without Compliance & Audit, is the software less secure?",
    a: "No. Encryption, backups, role-based access and development to best practice are always included. Compliance & Audit adds the checks and documents for anyone who has to prove it to someone: your DPO, shareholders, clients, auditors.",
  },
  {
    q: "Does the documentation replace my DPO or my lawyer?",
    a: "No. We prepare the technical documentation your DPO and your legal team use for their assessments. The legal judgement stays with them.",
  },
  {
    q: "What do you do about the AI Act?",
    a: "With Compliance & Audit we classify the risk level of the system, prepare the technical documentation and the record of decisions, make it explicit to users when they are interacting with AI, and document the human oversight points. The reference is Regulation (EU) 2024/1689. As with the GDPR, the legal judgement stays with your lawyer.",
  },
  {
    q: "What happens if work is left over at the end of a Sprint?",
    a: "You find it in the portal, already in priority order. You can start another Sprint right away, later or never: it’s your call.",
  },
  {
    q: "Can I keep the team all year?",
    a: "Yes, with consecutive Sprints. For long commitments or several applications in parallel we build a tailored path.",
  },
  {
    q: "Who pays for hosting and AI services?",
    a: "You do, directly, on accounts in your company’s name. No markup, no dependency on us.",
  },
  {
    q: "What if the first month doesn’t convince me?",
    a: "We refund you. Or we work for free until you are satisfied.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    url: "https://www.soraia.io/en/pricing",
    inLanguage: "en",
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Custom software and AI agents in monthly Sprints. Soraia",
    provider: { "@type": "Organization", name: "Soraia", url: "https://www.soraia.io" },
    areaServed: "IT",
    serviceType: "Custom software development and AI agents",
    offers: [
      {
        "@type": "Offer",
        name: "Analysis",
        price: "3000",
        priceCurrency: "EUR",
        description:
          "Process mapping, software blueprint, priorities and acceptance criteria, an estimate in Sprint months and a fixed-price quote. Optional, deducted from the first Sprint if you start within 30 days. VAT excluded.",
      },
      {
        "@type": "Offer",
        name: "Sprint",
        price: "5000",
        priceCurrency: "EUR",
        description:
          "Account Manager, Project Manager and AI Engineer, a Sprint Goal signed at the start of the month, a demo mid-month and a release in production at the end of the month. Even for a single month. VAT excluded.",
      },
      {
        "@type": "Offer",
        name: "Hypercare",
        price: "500",
        priceCurrency: "EUR",
        description:
          "After go-live: monitoring, bug fixing, security and technical updates, a monthly report. Optional, annual contract. VAT excluded.",
      },
      {
        "@type": "Offer",
        name: "Compliance & Audit",
        price: "2000",
        priceCurrency: "EUR",
        description:
          "Sprint add-on, for every Sprint month: technical documentation for your DPO and legal team on GDPR and the AI Act, encryption of sensitive fields, audit logs, retention policy, load testing, monitoring and SLAs. VAT excluded.",
      },
      {
        "@type": "Offer",
        name: "Pentest",
        price: "4000",
        priceCurrency: "EUR",
        description:
          "Sprint add-on: a security test run by an external partner before release, a report you can hand over and the fixing of critical vulnerabilities. VAT excluded.",
      },
      {
        "@type": "Offer",
        name: "Training and adoption",
        price: "2500",
        priceCurrency: "EUR",
        description:
          "Sprint add-on: two sessions with your team, video tutorials and a user manual, a check-in session after 30 days. VAT excluded.",
      },
      {
        "@type": "Offer",
        name: "Grant support",
        price: "1000",
        priceCurrency: "EUR",
        description:
          "Analysis add-on: requirements check, a quote that complies with the grant, technical documentation for the application and support with reporting. VAT excluded.",
      },
      {
        "@type": "Offer",
        name: "AI Quality",
        price: "500",
        priceCurrency: "EUR",
        description:
          "Hypercare add-on: a monthly test of the agents’ answers on real cases, instruction tuning and control of API costs. VAT excluded.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];

const guarantees = [
  {
    text: "First month satisfied or refunded",
    icon: `<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"></path><path d="M9 12l2 2 4-4"></path>`,
  },
  {
    text: "Even a single month, no lock-in",
    icon: `<rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M8 3v4"></path><path d="M16 3v4"></path><path d="M3 11h18"></path>`,
  },
  {
    text: "Fixed price, no surprises on the invoice",
    icon: `<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 10h18"></path>`,
  },
  {
    text: "Code and data on accounts in your name",
    icon: `<rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 018 0v4"></path>`,
  },
  {
    text: "Baseline security always included",
    icon: `<path d="M5 12l5 5L20 7"></path>`,
  },
];

const servizi = [
  {
    n: "1",
    name: "Analysis",
    title: "You know what to build, and what it costs",
    price: "€3,000",
    unit: " one-off",
    note: "Optional. Deducted from the first Sprint if you start within 30 days.",
    items: [
      "Process mapping with the people who live them",
      "Software blueprint and technical choices",
      "Priorities and acceptance criteria in writing",
      "An estimate in Sprint months and a fixed-price quote",
    ],
    addons: "Grant support",
    cta: "Book the Analysis",
    featured: false,
  },
  {
    n: "2",
    name: "Sprint",
    title: "The dedicated team, one month at a time",
    price: "€5,000",
    unit: " /month",
    note: "Even a single month, no lock-in. Paid at the start of the Sprint.",
    items: [
      "Account Manager, Project Manager and AI Engineer",
      "Sprint Goal agreed and signed at the start of the month",
      "Demo mid-month, release in production at the end of the month",
      "Data encryption, backups, role-based access, OWASP best practice",
      "Historical data import and migration from the systems you use today",
      "Client portal with progress in real time",
      "Three months of change requests included after release",
    ],
    addons: "Compliance & Audit, Pentest, Training and adoption",
    cta: "Start a Sprint",
    featured: true,
  },
  {
    n: "3",
    name: "Hypercare",
    title: "The software stays looked after",
    price: "€500",
    unit: " /month",
    from: true,
    note: "Optional. Annual contract from go-live.",
    items: [
      "Monitoring and bug fixing",
      "Security and technical updates",
      "Monthly report on security, performance and real usage",
      "Improvement proposals for the next Sprints",
    ],
    foot: "The price depends on users and integrations. New features go into a Sprint.",
    addons: "AI Quality",
    cta: "Let’s talk",
    featured: false,
  },
];

const addonSprint = [
  {
    name: "Compliance & Audit",
    price: "€2,000",
    unit: " /month",
    claim: "For sensitive data, external users, audits by shareholders or clients",
    items: [
      "Technical documentation for your DPO and legal team: art. 32 GDPR measures, DPIA support, a map of the data flows",
      "AI Act compliance: risk classification, technical documentation, transparency towards users and human oversight",
      "Encryption of sensitive fields, audit logs, retention and deletion policy",
      "Load testing, monitoring and availability SLA",
    ],
    foot: "For every month of Sprint.",
  },
  {
    name: "Pentest",
    price: "€4,000",
    unit: " one-off",
    claim: "To prove the software holds up against an attack",
    items: [
      "Security test run by an external partner before release",
      "A report you can hand to auditors, clients and your insurer",
      "Fixing of critical vulnerabilities included",
    ],
  },
  {
    name: "Training and adoption",
    price: "€2,500",
    unit: " one-off",
    claim: "So that people actually use it",
    items: [
      "2 sessions with your team, in person or online",
      "Video tutorials on the main features and a user manual",
      "A check-in session after 30 days",
    ],
  },
];

const addonAltri = [
  {
    group: "With the Analysis",
    name: "Grant support",
    price: "€1,000",
    unit: " one-off",
    claim: "To fund the project with a grant",
    items: [
      "Requirements check and a quote that complies with the grant",
      "Technical documentation for the application",
      "Support with reporting",
    ],
    cta: { label: "Check whether your project can be funded", href: "/en/contact" },
  },
  {
    group: "With Hypercare",
    name: "AI Quality",
    price: "€500",
    unit: " /month",
    claim: "For AI agents that stay reliable over time",
    items: [
      "Monthly test of the agents’ answers on real cases",
      "Instruction tuning when quality drops",
      "Control of API costs with alerts and a monthly report",
    ],
    foot: "With Hypercare active.",
  },
];

const metodo = [
  {
    n: "01",
    title: "Analysis",
    body: "Processes, priorities, acceptance criteria and an estimate in Sprints.",
  },
  {
    n: "02",
    title: "Sprint Goal signed",
    body: "One page with the goal of the month and what goes in. You approve it.",
  },
  {
    n: "03",
    title: "Demo mid-month",
    body: "You see the work running and correct course before it is too late.",
    milestone: true,
  },
  {
    n: "04",
    title: "Release at the end of the month",
    body: "In production, on your accounts, with a report of what was done.",
    milestone: true,
  },
  {
    n: "05",
    title: "Hypercare",
    body: "From go-live we keep the software monitored, secure and up to date.",
  },
];

const sicurezzaBase = [
  "Data encryption in transit and at rest",
  "Backups and role-based access",
  "Development to OWASP best practice",
  "Code and data on accounts in your name",
];

const sicurezzaPlus = [
  "Technical documentation for your DPO and legal team",
  "AI Act compliance: risk, documentation, transparency",
  "Encryption of sensitive fields and audit logs",
  "Load testing, monitoring and SLAs",
  "External pentest before release, with a report",
];

const regole = [
  {
    title: "The Sprint Goal is the pact of the month",
    body: "We write it together and you approve it. It is the reference for what was delivered.",
  },
  {
    title: "Mid-Sprint: next month or a swap",
    body: "A new request goes to the next Sprint, or comes in straight away in place of something else.",
  },
  {
    title: "You decide the priorities",
    body: "The time is fixed, the order of the work is yours. Everything is visible in the client portal.",
  },
  {
    title: "Access and feedback on time",
    body: "A Sprint has fixed dates. If access or answers are missing, the maximum slip is 5 working days.",
  },
  {
    title: "Third-party costs on your accounts",
    body: "You pay for hosting and AI services directly, at cost, with no markup.",
  },
  {
    title: "Hypercare maintains, the Sprint builds",
    body: "Hypercare keeps the software healthy and secure. New features, modules and integrations happen in a Sprint.",
  },
];
---

<Layout title={title} description={description} lang="en" jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-violet-mesh">
    <div class="orb orb-violet w-[500px] h-[500px] -top-32 -right-20 opacity-40 float-slow" aria-hidden="true"></div>
    <div class="container-soraia pt-16 md:pt-24 pb-14 md:pb-20 relative z-10">
      <p class="eyebrow mb-5">Pricing</p>
      <h1 class="text-ink text-balance" style="font-size: clamp(2.5rem, 5vw + 1rem, 3.75rem); line-height: 1.05; letter-spacing: -0.025em; font-weight: 500; max-width: 20ch;">
        A team that brings to life the software you need.
      </h1>
      <p class="mt-6 text-[17px] md:text-[18px] leading-relaxed text-pretty max-w-2xl" style="color: var(--color-ink-muted);">
        Account Manager, Project Manager and AI Engineer, with a proven method. Three steps at a fixed price, plus the add-ons your project needs. No hour packages to count. <a href="/en/ai-engineering" style="color: var(--color-brand); font-weight: 600;">How we work, in detail &rarr;</a>
      </p>
      <ul class="flex flex-wrap gap-3 mt-10 list-none p-0">
        {guarantees.map((g) => (
          <li class="card !py-3.5 !px-5 flex items-center gap-2.5 text-[15px] font-medium">
            <svg class="shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={g.icon} />
            {g.text}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- THREE SERVICES -->
  <section class="section" id="services">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="How it works"
        title="Three steps, each with its own fixed price"
        subtitle="Start with the Analysis if you need it, turn on the team for as many months as you want, then choose whether to keep the software looked after. Prices exclude VAT."
      />

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">
        {servizi.map((s) => (
          <div
            class="card card-hover flex flex-col gap-5 !p-8"
            style={s.featured ? "border: 2px solid var(--color-brand); box-shadow: 0 18px 40px -20px rgba(74,30,92,0.35);" : undefined}
          >
            <div>
              <p class="eyebrow" style="color: var(--color-brand);">{s.n} &middot; {s.name}</p>
              <h3 class="mt-2 text-[1.5rem] font-medium tracking-tight text-balance">{s.title}</h3>
            </div>
            <div>
              {s.from && <span class="text-[15px]" style="color: var(--color-ink-soft);">from </span>}
              <span class="bignum">{s.price}</span><span class="text-[16px]" style="color: var(--color-ink-soft);">{s.unit}</span>
              <p class="text-[14px] mt-1" style="color: var(--color-ink-soft);">{s.note}</p>
            </div>
            <ul class="flex flex-col gap-2.5 text-[15px] list-none p-0 m-0">
              {s.items.map((item) => (
                <li class="flex items-start gap-2.5">
                  <svg class="shrink-0 mt-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            {s.foot && <p class="text-[13.5px]" style="color: var(--color-ink-soft);">{s.foot}</p>}
            <p class="text-[13.5px] mt-auto pt-2" style="color: var(--color-ink-soft); border-top: 1px solid var(--color-line);">
              <span class="font-semibold" style="color: var(--color-brand);">Add-ons:</span> {s.addons}
            </p>
            <a href="/en/contact" class={`btn ${s.featured ? "btn-primary" : "btn-secondary"} justify-center`}>{s.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ADD-ONS -->
  <section class="section" id="add-ons" style="background: var(--color-surface);">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="Add-ons"
        title="Every add-on completes one of the three services"
        subtitle="Analysis, Sprint and Hypercare are the services. Add-ons are optional and attach to one of them only: you pick them when you turn that service on."
      />

      <p class="eyebrow mb-4" style="color: var(--color-brand);">With the Sprint</p>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">
        {addonSprint.map((a) => (
          <div class="card flex flex-col gap-4 !p-7">
            <div>
              <h3 class="text-[1.25rem] font-medium tracking-tight">{a.name}</h3>
              <div class="mt-1 whitespace-nowrap">
                <span class="bignum" style="font-size: clamp(1.5rem, 2.5vw, 1.75rem);">{a.price}</span><span class="text-[14px]" style="color: var(--color-ink-soft);">{a.unit}</span>
              </div>
            </div>
            <p class="text-[15px]" style="color: var(--color-ink-muted);">{a.claim}</p>
            <ul class="flex flex-col gap-2.5 text-[14.5px] list-none p-0 m-0">
              {a.items.map((item) => (
                <li class="flex items-start gap-2.5">
                  <svg class="shrink-0 mt-1" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            {a.foot && <p class="text-[13.5px] mt-auto" style="color: var(--color-ink-soft);">{a.foot}</p>}
          </div>
        ))}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch mt-10">
        {addonAltri.map((a) => (
          <div class="card flex flex-col gap-4 !p-7">
            <p class="eyebrow" style="color: var(--color-brand);">{a.group}</p>
            <div>
              <h3 class="text-[1.25rem] font-medium tracking-tight">{a.name}</h3>
              <div class="mt-1 whitespace-nowrap">
                <span class="bignum" style="font-size: clamp(1.5rem, 2.5vw, 1.75rem);">{a.price}</span><span class="text-[14px]" style="color: var(--color-ink-soft);">{a.unit}</span>
              </div>
            </div>
            <p class="text-[15px]" style="color: var(--color-ink-muted);">{a.claim}</p>
            <ul class="flex flex-col gap-2.5 text-[14.5px] list-none p-0 m-0">
              {a.items.map((item) => (
                <li class="flex items-start gap-2.5">
                  <svg class="shrink-0 mt-1" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            {a.foot && <p class="text-[13.5px]" style="color: var(--color-ink-soft);">{a.foot}</p>}
            {a.cta && <a href={a.cta.href} class="btn btn-secondary mt-auto justify-center">{a.cta.label}</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THE METHOD -->
  <section class="section">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="The method"
        title="What is included in a month of Sprint? The team, the method and a release."
        subtitle="What to build we decide together at the start of the month and put in writing. You know what arrives, we know what to deliver."
      />
      <ol class="sprint-timeline sprint-timeline--five">
        {metodo.map((s) => (
          <li class={`sprint-step${s.milestone ? " sprint-step--milestone" : ""}`}>
            <div class="sprint-step-head">
              <span class={`sprint-num${s.milestone ? " sprint-num--milestone" : ""}`}>{s.n}</span>
              <div class="sprint-step-meta">
                <span class="sprint-step-title">{s.title}</span>
              </div>
            </div>
            <p class="sprint-step-body">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PATH BUILDER -->
  <section class="section" id="path" style="background: var(--color-surface);">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="Build your path"
        title="What does a project cost? See for yourself."
        subtitle="Starting example: a custom CRM holding client data, over 3 months of Sprint. Change the values for your case."
      />
      <PathBuilder client:load lang="en" />
    </div>
  </section>

  <!-- SECURITY -->
  <section class="section">
    <div class="container-soraia">
      <SectionHeader
        title="Security: done well always, demonstrable when it matters"
        subtitle="Every Sprint builds secure software. Compliance & Audit and Pentest add the checks and the documents for anyone who asks you to prove it: your DPO, shareholders, clients, auditors, your insurer."
      />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
        <div class="card flex flex-col gap-4 !p-8">
          <h3 class="text-[1.25rem] font-medium tracking-tight">Always included in every Sprint</h3>
          <ul class="flex flex-col gap-3 text-[15px] list-none p-0 m-0">
            {sicurezzaBase.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="shrink-0 mt-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-[1.375rem] !p-8 flex flex-col gap-4 bg-lines-dark" style="background-color: #1A0820; color: #fff;">
          <h3 class="text-[1.25rem] font-medium tracking-tight" style="color: #fff;">With Compliance &amp; Audit and Pentest</h3>
          <ul class="flex flex-col gap-3 text-[15px] list-none p-0 m-0">
            {sicurezzaPlus.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="shrink-0 mt-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-violet-200)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                <span style="color: rgba(255,255,255,0.86);">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- RULES -->
  <section class="section bg-hero-dark">
    <div class="container-soraia">
      <SectionHeader
        variant="dark"
        title="Clear rules, the same for everyone"
        subtitle="They are written into the contract. They protect you as much as us, and they avoid arguments at the end of the month."
      />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {regole.map((r) => (
          <div class="dk-card">
            <h3 class="text-[1.0625rem] font-medium tracking-tight" style="color: #fff;">{r.title}</h3>
            <p class="mt-2.5 text-[15px] leading-relaxed text-pretty" style="color: rgba(255,255,255,0.72);">{r.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GRANT BANNER -->
