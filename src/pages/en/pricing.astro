---
import Layout from "~/layouts/Layout.astro";
import PricingCalculator from "~/components/PricingCalculator.tsx";
import SectionHeader from "~/components/SectionHeader.astro";
import "~/styles/prezzi.css";

const title = "Pricing | Soraia";
const description =
  "Simple, transparent pricing: hour packages (from €3,000 for 45 hours a month) or fixed-price releases (from €5,000 for a first release). First month satisfied or refunded.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  url: "https://www.soraia.io/en/pricing",
  inLanguage: "en",
};
---

<Layout title={title} description={description} lang="en" jsonLd={jsonLd}>
  <!-- HERO = two ways to work + calculator -->
  <section class="relative overflow-hidden bg-violet-mesh">
    <div class="orb orb-violet w-[500px] h-[500px] -top-32 -right-20 opacity-40 float-slow" aria-hidden="true"></div>
    <div class="container-soraia pt-16 md:pt-24 pb-14 md:pb-16 relative z-10">
      <header class="max-w-3xl text-center mx-auto mb-12 md:mb-14">
        <p class="eyebrow mb-5">Two ways of working</p>
        <h1 class="text-ink text-balance" style="font-size: clamp(2.5rem, 5vw + 1rem, 3.75rem); line-height: 1.05; letter-spacing: -0.025em; font-weight: 500;">
          Choose how you prefer to work with us.
        </h1>
        <p class="mt-6 text-[17px] md:text-[18px] leading-relaxed text-pretty max-w-2xl mx-auto" style="color: var(--color-ink-muted);">
          Hour packages or fixed price, from €3,000 a month. Either way we work in sprints, iteratively, and you see everything in the project dashboard. <a href="/en/ai-engineering" style="color: var(--color-brand); font-weight: 600;">How we work, in detail &rarr;</a>
        </p>
      </header>
      <PricingCalculator client:load lang="en" />
    </div>
  </section>

  <!-- CLIENT PORTAL (embedded live demo) -->
  <section class="section pt-0">
    <div class="container-soraia">
      <div class="max-w-2xl mb-8">
        <p class="eyebrow mb-4">Transparency</p>
        <h2 class="text-balance" style="font-size: clamp(1.875rem, 3vw + 0.5rem, 2.5rem); line-height: 1.1; letter-spacing: -0.025em; font-weight: 500;">The client portal, in real time</h2>
        <p class="mt-4 text-[17px] leading-relaxed text-pretty" style="color: var(--color-ink-muted);">
          Every client gets this portal: the tickets in progress, the hours per sprint and per person, the project's progress. No black box, no reports to chase. Try it below, with sample data.
        </p>
      </div>
      <div class="portal-embed">
        <div class="portal-embed__bar">
          <span class="portal-embed__dot" style="background:#ff5f57;"></span>
          <span class="portal-embed__dot" style="background:#febc2e;"></span>
          <span class="portal-embed__dot" style="background:#28c840;"></span>
          <span class="portal-embed__url">Client portal · Nordica HR (demo)</span>
          <button type="button" id="portalExpand" class="portal-embed__expand" aria-label="Open fullscreen">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M16 21h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            Fullscreen
          </button>
        </div>
        <iframe id="portalFrame" src="/demo-portale?embed=1" title="Soraia client portal, interactive demo" loading="lazy"></iframe>
      </div>
      <p class="text-center text-[13px] mt-4" style="color: var(--color-ink-soft);">
        Move around freely: switch sprint, open each person's hours breakdown, filter and search the tickets.
      </p>
    </div>
  </section>
  <script is:inline>
    (function () {
      var b = document.getElementById("portalExpand"), f = document.getElementById("portalFrame");
      if (!b || !f) return;
      b.addEventListener("click", function () {
        var req = f.requestFullscreen || f.webkitRequestFullscreen || f.msRequestFullscreen;
        if (req) { try { req.call(f); return; } catch (e) {} }
        window.open("/demo-portale", "_blank");
      });
    })();
  </script>

  <!-- CTA -->
  <section class="section">
    <div class="container-soraia max-w-2xl text-center">
      <h2 class="text-balance" style="font-size: clamp(1.75rem, 3vw + 0.5rem, 2.25rem); line-height: 1.15; letter-spacing: -0.025em; font-weight: 500;">Let's start with a conversation, not a quote</h2>
      <p class="mt-4 text-[17px] leading-relaxed text-pretty" style="color: var(--color-ink-muted);">
        Half an hour to understand the problem, the scope, and how many hours it really takes in your case. No commitment.
      </p>
      <div class="mt-7">
        <a href="/en/contact" class="btn btn-primary">
          20 min with Daniel
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
