---
import Layout from "~/layouts/Layout.astro";
import PathBuilder from "~/components/PathBuilder.tsx";
import SectionHeader from "~/components/SectionHeader.astro";
import ComparisonTable from "~/components/ComparisonTable.astro";
import FAQ from "~/components/FAQ.astro";
import "~/styles/prezzi.css";

const title = "Pricing | Soraia";
const description =
  "A team that brings to life the software you need. Sprint from €5,000 a month, Sprint Pro from €8,000 with demonstrable security and compliance with GDPR and the AI Act, Partner from €12,000. Fixed price, one release every month.";

const faqs = [
  {
    q: "What exactly is included in a month of Sprint?",
    a: "The dedicated team, the method and one release in production. What we build is defined together in the Sprint Goal at the start of the month: that document says what you get.",
  },
  {
    q: "Is the base Sprint less secure?",
    a: "No. Encryption, backups, role-based access and development to best practice are always included. Sprint Pro adds the checks and the documents you need when someone asks you to prove it: your DPO, shareholders, clients, auditors.",
  },
  {
    q: "When is Sprint Pro worth it?",
    a: "When the application handles sensitive data, is used by external clients or suppliers, carries a core process or has to pass an audit. For internal tools, Sprint is the right choice.",
  },
  {
    q: "Does the documentation replace my DPO or my lawyer?",
    a: "No. We prepare the technical documentation your DPO and your legal team use for their assessments. The legal judgement stays with them.",
  },
  {
    q: "What do you do about the AI Act?",
    a: "We classify the risk level of the system, prepare the technical documentation and the record of decisions, make it explicit to users when they are interacting with AI, and document the human oversight points. The reference is Regulation (EU) 2024/1689. As with the GDPR, the legal judgement stays with your lawyer.",
  },
  {
    q: "What happens if work is left over at the end of a Sprint?",
    a: "You find it in the portal, already in priority order. You can start another Sprint right away, later or never: it’s your call.",
  },
  {
    q: "Who pays for hosting and AI services?",
    a: "You do, directly, on accounts in your company’s name. No markup, no dependency on us.",
  },
  {
    q: "What if the first month doesn’t convince me?",
    a: "We refund you. Or we work for free until you’re satisfied.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    url: "https://www.soraia.io/en/pricing",
    inLanguage: "en",
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Custom software and AI agents in monthly Sprints. Soraia",
    provider: { "@type": "Organization", name: "Soraia", url: "https://www.soraia.io" },
    areaServed: "IT",
    serviceType: "Custom software development and AI agents",
    offers: [
      {
        "@type": "Offer",
        name: "Sprint",
        price: "5000",
        priceCurrency: "EUR",
        description:
          "Account Manager, Project Manager and AI Engineer, a Sprint Goal signed at the start of the month, a demo mid-month and a release in production at the end of the month. VAT excluded.",
      },
      {
        "@type": "Offer",
        name: "Sprint Pro",
        price: "8000",
        priceCurrency: "EUR",
        description:
          "Everything in Sprint, plus an external pentest with a report, technical documentation for your DPO and legal team on GDPR and the AI Act, audit logs, load tests, SLAs, historical data import and migration, a part-time CTO and three months of change requests after release. VAT excluded.",
      },
      {
        "@type": "Offer",
        name: "Partner",
        price: "12000",
        priceCurrency: "EUR",
        description:
          "Everything in Sprint Pro, plus a continuous team, a quarterly review of results, Hypercare included and priority. Three-month minimum. VAT excluded.",
      },
      {
        "@type": "Offer",
        name: "Hypercare",
        price: "500",
        priceCurrency: "EUR",
        description:
          "After go-live: monitoring, bug fixes, security and technical updates, a monthly report. Annual contract. VAT excluded.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];

const guarantees = [
  {
    text: "First month satisfied or refunded",
    icon: `<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"></path><path d="M9 12l2 2 4-4"></path>`,
  },
  {
    text: "Even a single month, no lock-in",
    icon: `<rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M8 3v4"></path><path d="M16 3v4"></path><path d="M3 11h18"></path>`,
  },
  {
    text: "Fixed price, no surprises on the invoice",
    icon: `<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 10h18"></path>`,
  },
  {
    text: "Code and data on accounts in your name",
    icon: `<rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 018 0v4"></path>`,
  },
  {
    text: "Baseline security included in every Sprint",
    icon: `<path d="M5 12l5 5L20 7"></path>`,
  },
];

const metodo = [
  {
    n: "01",
    title: "Blueprint",
    body: "In the first Sprint we map processes, priorities and acceptance criteria.",
  },
  {
    n: "02",
    title: "Signed Sprint Goal",
    body: "One page with the goal of the month and what goes in. You approve it.",
  },
  {
    n: "03",
    title: "Demo mid-month",
    body: "You see the work running and correct course before it’s too late.",
    milestone: true,
  },
  {
    n: "04",
    title: "Release at the end of the month",
    body: "In production, on your accounts, with a report of what was done.",
    milestone: true,
  },
  {
    n: "05",
    title: "Hypercare",
    body: "From go-live we keep the software monitored, secure and up to date.",
  },
];

const regole = [
  {
    title: "The Sprint Goal is the month’s agreement",
    body: "We write it together and you approve it. It’s the reference for what was delivered.",
  },
  {
    title: "Mid-Sprint: next month or a swap",
    body: "A new request goes into the next Sprint, or comes in right away in place of something else.",
  },
  {
    title: "You decide the priorities",
    body: "The time is fixed, the order of the work is yours. Everything is visible in the client portal.",
  },
  {
    title: "Access and feedback on time",
    body: "A Sprint has fixed dates. If access or answers are missing, the maximum slip is 5 working days.",
  },
  {
    title: "Third-party costs on your accounts",
    body: "You pay for hosting and AI services directly, at cost, with no markup.",
  },
  {
    title: "Hypercare maintains, the Sprint builds",
    body: "Hypercare keeps the software healthy and secure. New features, modules and integrations happen in a Sprint.",
  },
];

const confronto = {
  columns: ["Sprint", "Sprint Pro", "Partner"] as [string, string, string],
  rows: [
    { label: "Encryption of data in transit and at rest", values: ["Included", "Included", "Included"] as [string, string, string] },
    { label: "Backups and role-based access", values: ["Included", "Included", "Included"] as [string, string, string] },
    { label: "Development to OWASP best practice", values: ["Included", "Included", "Included"] as [string, string, string] },
    { label: "Code and data on accounts in your name", values: ["Included", "Included", "Included"] as [string, string, string] },
    { label: "External pentest before release, with a report", values: ["No", "Included", "Included"] as [string, string, string] },
    { label: "Technical documentation for DPO and legal (art. 32 GDPR, DPIA, data flows)", values: ["No", "Included", "Included"] as [string, string, string] },
    { label: "AI Act compliance (risk classification, documentation, transparency)", values: ["No", "Included", "Included"] as [string, string, string] },
    { label: "Encryption of sensitive fields, audit logs, retention policy", values: ["No", "Included", "Included"] as [string, string, string] },
    { label: "Load testing, monitoring and availability SLA", values: ["No", "Included", "Included"] as [string, string, string] },
    { label: "Historical data import and data migration", values: ["No", "Included", "Included"] as [string, string, string] },
    { label: "Part-time CTO", values: ["No", "Included", "Included"] as [string, string, string] },
    { label: "Minimum commitment", values: ["One month", "One month", "3 months"] as [string, string, string] },
    { label: "Start", values: ["Subject to availability", "Within 5 working days", "Continuous"] as [string, string, string] },
    { label: "Change requests after release", values: ["No", "3 months included", "3 months included"] as [string, string, string] },
    { label: "Quarterly review of results", values: ["No", "No", "Included"] as [string, string, string] },
    { label: "Hypercare after release", values: ["From €500/month", "From €500/month", "Included"] as [string, string, string] },
  ],
};
---

<Layout title={title} description={description} lang="en" jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-violet-mesh">
    <div class="orb orb-violet w-[500px] h-[500px] -top-32 -right-20 opacity-40 float-slow" aria-hidden="true"></div>
    <div class="container-soraia pt-16 md:pt-24 pb-14 md:pb-20 relative z-10">
      <p class="eyebrow mb-5">Pricing</p>
      <h1 class="text-ink text-balance" style="font-size: clamp(2.5rem, 5vw + 1rem, 3.75rem); line-height: 1.05; letter-spacing: -0.025em; font-weight: 500; max-width: 20ch;">
        A team that brings to life the software you need.
      </h1>
      <p class="mt-6 text-[17px] md:text-[18px] leading-relaxed text-pretty max-w-2xl" style="color: var(--color-ink-muted);">
        An Account Manager, a Project Manager and an AI Engineer, with a method that works. A fixed price per month, one guaranteed release every Sprint. <a href="/en/ai-engineering" style="color: var(--color-brand); font-weight: 600;">How we work, in detail &rarr;</a>
      </p>
      <ul class="flex flex-wrap gap-3 mt-10 list-none p-0">
        {guarantees.map((g) => (
          <li class="card !py-3.5 !px-5 flex items-center gap-2.5 text-[15px] font-medium">
            <svg class="shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={g.icon} />
            {g.text}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- THREE LEVELS -->
  <section class="section" id="levels">
    <div class="container-soraia">
      <SectionHeader
        title="The same team and the same method. Pick the right level for your application."
        subtitle="Every level builds solid software. What changes is how demonstrable it has to be: verified security, documentation for your DPO and the AI Act, guaranteed performance. Prices exclude VAT."
      />

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">
        <!-- SPRINT -->
        <div class="card card-hover flex flex-col gap-5 !p-8">
          <div>
            <p class="eyebrow" style="color: var(--color-brand);">Sprint</p>
            <h3 class="mt-2 text-[1.5rem] font-medium tracking-tight">The solid base</h3>
            <p class="mt-2 text-[15px]" style="color: var(--color-ink-muted);">Recommended for internal or less strategic applications.</p>
          </div>
          <div>
            <span class="bignum">€5,000</span><span class="text-[16px]" style="color: var(--color-ink-soft);"> /month</span>
            <p class="text-[14px] mt-1" style="color: var(--color-ink-soft);"><span class="font-semibold" style="color: var(--color-brand);">Even a single month, no lock-in.</span> Paid at the start of the Sprint.</p>
          </div>
          <ul class="flex flex-col gap-2.5 text-[15px] list-none p-0 m-0">
            {[
              "An Account Manager, a Project Manager and an AI Engineer",
              "Sprint Goal agreed and signed at the start of the month",
              "Demo mid-month, release in production at the end of the month",
              "Data encryption, backups, role-based access",
              "Development to OWASP security best practice",
              "Client portal with progress in real time",
            ].map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="shrink-0 mt-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a href="/en/contact" class="btn btn-secondary mt-auto justify-center">Start a Sprint</a>
        </div>

        <!-- SPRINT PRO -->
        <div class="card card-hover flex flex-col gap-5 !p-8" style="border: 2px solid var(--color-brand); box-shadow: 0 18px 40px -20px rgba(74,30,92,0.35);">
          <div>
            <div class="flex items-center justify-between gap-3">
              <p class="eyebrow" style="color: var(--color-brand);">Sprint Pro</p>
              <span class="shrink-0 text-[12.5px] font-semibold rounded-full px-3 py-1.5 whitespace-nowrap" style="background: var(--color-brand); color: #fff;">Limited slots</span>
            </div>
            <h3 class="mt-2 text-[1.5rem] font-medium tracking-tight text-balance">Demonstrable security and compliance</h3>
            <p class="mt-2 text-[15px]" style="color: var(--color-ink-muted);">For critical applications: sensitive data, external users, core processes, audits by shareholders or clients.</p>
          </div>
          <div>
            <span class="bignum">€8,000</span><span class="text-[16px]" style="color: var(--color-ink-soft);"> /month</span>
            <p class="text-[14px] mt-1" style="color: var(--color-ink-soft);"><span class="font-semibold" style="color: var(--color-brand);">Even a single month, no lock-in.</span> A maximum of 3 Pro clients at a time.</p>
          </div>
          <p class="text-[14px] font-semibold" style="color: var(--color-brand);">Everything in Sprint, plus:</p>
          <ul class="flex flex-col gap-2.5 text-[15px] list-none p-0 m-0">
            {[
              "External pentest before release, with a report you can hand over",
              "Technical documentation for your DPO and legal team: art. 32 GDPR measures, DPIA support, a map of the data flows",
              "AI Act compliance: risk classification of the system, technical documentation, transparency towards users and human oversight",
              "Encryption of sensitive fields, audit logs, data retention policy",
              "Load testing, monitoring and availability SLA",
              "Historical data import and migration from the systems you use today",
              "Davide Silvestri as a part-time CTO on your project",
              "Start within 5 working days",
              "Three months of change requests included after release",
            ].map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="shrink-0 mt-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a href="/en/contact" class="btn btn-primary mt-auto justify-center">Check availability</a>
        </div>

        <!-- PARTNER -->
        <div class="rounded-[1.375rem] !p-8 flex flex-col gap-5 bg-lines-dark" style="background-color: #1A0820; color: #fff;">
          <div>
            <p class="eyebrow eyebrow-light">Partner</p>
            <h3 class="mt-2 text-[1.5rem] font-medium tracking-tight text-balance" style="color: #fff;">Your technical department, without hiring</h3>
            <p class="mt-2 text-[15px]" style="color: rgba(255,255,255,0.72);">For those with several applications and a continuous roadmap.</p>
          </div>
          <div>
            <span class="text-[15px]" style="color: rgba(255,255,255,0.72);">from </span><span class="bignum" style="color: #fff;">€12,000</span><span class="text-[16px]" style="color: rgba(255,255,255,0.72);"> /month</span>
            <p class="text-[14px] mt-1" style="color: rgba(255,255,255,0.68);">Three-month minimum. Tailored.</p>
          </div>
          <p class="text-[14px] font-semibold" style="color: var(--color-violet-200);">Everything in Sprint Pro, plus:</p>
          <ul class="flex flex-col gap-2.5 text-[15px] list-none p-0 m-0">
            {[
              "A continuous team, with no restarts between one project and the next",
              "Quarterly review of results: hours saved, costs, processes",
              "Hypercare included on every application",
              "Priority on requests and urgent work",
            ].map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="shrink-0 mt-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-violet-200)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a href="/en/contact" class="btn !bg-white !text-violet-900 hover:!bg-violet-50 mt-auto justify-center">Let’s talk</a>
        </div>
      </div>
    </div>
  </section>

  <!-- AFTER THE RELEASE -->
  <section class="section" style="background: var(--color-surface);">
    <div class="container-soraia">
      <SectionHeader eyebrow="After the release" title="Hypercare, so the software stays alive" />
      <div class="card !p-8 md:!p-10 max-w-3xl">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h3 class="text-[1.375rem] font-medium tracking-tight">Hypercare</h3>
          <div>
            <span class="text-[15px]" style="color: var(--color-ink-soft);">from </span><span class="bignum" style="font-size: clamp(1.875rem, 3vw, 2.25rem);">€500</span><span class="text-[15px]" style="color: var(--color-ink-soft);"> /month</span>
          </div>
        </div>
        <p class="mt-4 text-[16px] leading-relaxed text-pretty" style="color: var(--color-ink-muted);">
          Annual contract. From go-live the software stays looked after: monitoring, bug fixes, security and technical updates, a monthly report on security, performance and real usage, with proposals for improvement.
        </p>
        <p class="mt-3 text-[14px]" style="color: var(--color-ink-soft);">
          The price depends on users and integrations. New features, modules and integrations go into a Sprint.
        </p>
      </div>
    </div>
  </section>

  <!-- THE METHOD -->
  <section class="section">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="The method"
        title="What’s included in a month of Sprint? The team, the method and a release."
        subtitle="What to build is decided together at the start of the month and put in writing. You know what’s coming, we know what to deliver."
      />
      <ol class="sprint-timeline sprint-timeline--five">
        {metodo.map((s) => (
          <li class={`sprint-step${s.milestone ? " sprint-step--milestone" : ""}`}>
            <div class="sprint-step-head">
              <span class={`sprint-num${s.milestone ? " sprint-num--milestone" : ""}`}>{s.n}</span>
              <div class="sprint-step-meta">
                <span class="sprint-step-title">{s.title}</span>
              </div>
            </div>
            <p class="sprint-step-body">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CLIENT PORTAL (embedded live demo) -->
  <section class="section pt-0">
    <div class="container-soraia">
      <div class="max-w-2xl mb-8">
        <p class="eyebrow mb-4">Transparency</p>
        <h2 class="text-balance" style="font-size: clamp(1.875rem, 3vw + 0.5rem, 2.5rem); line-height: 1.1; letter-spacing: -0.025em; font-weight: 500;">The client portal, in real time</h2>
        <p class="mt-4 text-[17px] leading-relaxed text-pretty" style="color: var(--color-ink-muted);">
          Every client gets this portal: the tickets in progress, the Sprint’s progress, what has been released. No black box, no reports to chase. Try it below, with sample data.
        </p>
      </div>
      <div class="portal-embed">
        <div class="portal-embed__bar">
          <span class="portal-embed__dot" style="background:#ff5f57;"></span>
          <span class="portal-embed__dot" style="background:#febc2e;"></span>
          <span class="portal-embed__dot" style="background:#28c840;"></span>
          <span class="portal-embed__url">Client portal · Nordica HR (demo)</span>
          <button type="button" id="portalExpand" class="portal-embed__expand" aria-label="Open fullscreen">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M16 21h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            Fullscreen
          </button>
        </div>
        <iframe id="portalFrame" src="/demo-portale?embed=1" title="Soraia client portal, interactive demo" loading="lazy"></iframe>
      </div>
      <p class="text-center text-[13px] mt-4" style="color: var(--color-ink-soft);">
        Move around freely: switch sprint, open each person’s detail, filter and search the tickets.
      </p>
    </div>
  </section>
  <script is:inline>
    (function () {
      var b = document.getElementById("portalExpand"), f = document.getElementById("portalFrame");
      if (!b || !f) return;
      b.addEventListener("click", function () {
        var req = f.requestFullscreen || f.webkitRequestFullscreen || f.msRequestFullscreen;
        if (req) { try { req.call(f); return; } catch (e) {} }
        window.open("/demo-portale", "_blank");
      });
    })();
  </script>

  <!-- PATH BUILDER -->
  <section class="section" id="path" style="background: var(--color-surface);">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="Build your path"
        title="How much does a project cost? See for yourself."
        subtitle="A starting example: a custom CRM in 3 months of Sprint Pro. Change the values for your own case and choose whether to add Hypercare."
      />
      <PathBuilder client:load lang="en" />
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="section">
    <div class="container-soraia">
      <SectionHeader
        title="Security, compliance and performance compared"
        subtitle="In Sprint, security is done properly. In Sprint Pro it’s also demonstrable, to whoever asks you for it."
      />
      <ComparisonTable columns={confronto.columns} rows={confronto.rows} highlightCol={1} />
    </div>
  </section>

  <!-- RULES -->
  <section class="section bg-hero-dark">
    <div class="container-soraia">
      <SectionHeader
        variant="dark"
        title="Clear rules, the same for everyone"
        subtitle="They’re written into the contract. They protect you as much as us, and they avoid arguments at the end of the month."
      />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {regole.map((r) => (
          <div class="dk-card">
            <h3 class="text-[1.0625rem] font-medium tracking-tight" style="color: #fff;">{r.title}</h3>
            <p class="mt-2.5 text-[15px] leading-relaxed text-pretty" style="color: rgba(255,255,255,0.72);">{r.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- QUOTE BANNER -->
  <section class="section !py-14" style="background: var(--color-surface);">
    <div class="container-soraia flex flex-wrap items-center justify-between gap-6">
      <div class="flex-1 min-w-0" style="flex-basis: 520px;">
        <h3 class="text-[1.5rem] font-medium tracking-tight text-balance">Do you have a public grant, or need a closed quote?</h3>
        <p class="mt-2 text-[16px] text-pretty" style="color: var(--color-ink-muted);">
          We start from the blueprint, then give you a quote with the list of deliverables fixed in writing.
        </p>
      </div>
      <a href="/en/contact" class="btn btn-secondary whitespace-nowrap">Let’s talk</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container-soraia max-w-3xl">
      <SectionHeader title="Frequently asked questions" />
      <FAQ items={faqs} />
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container-soraia max-w-2xl text-center">
