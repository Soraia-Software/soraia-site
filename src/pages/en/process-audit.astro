---
import Layout from "~/layouts/Layout.astro";
import AnalisiProcessi from "~/components/analisi/AnalisiProcessi.tsx";
import { NOINDEX } from "~/components/analisi/data";
import "~/styles/analisi.css";

const title = "Business process audit for SMEs | Soraia";
const description =
  "We come to your company, interview the people who do the work and map the flows, then hand you priorities and an action plan for automation and AI agents.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Process audit",
  provider: { "@type": "Organization", name: "Soraia" },
  areaServed: "IT",
  description,
  inLanguage: "en",
  offers: {
    "@type": "Offer",
    name: "Process audit",
    price: "3000",
    priceCurrency: "EUR",
    description: "Up to 10 on-site interviews, workflow map, priorities and action plan. VAT excluded.",
  },
};
---

<Layout
  title={title}
  description={description}
  lang="en"
  jsonLd={jsonLd}
  noindex={NOINDEX}
>
  <AnalisiProcessi client:load lang="en" />
</Layout>
