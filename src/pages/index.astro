---
import Layout from "~/layouts/Layout.astro";
import SectionHeader from "~/components/SectionHeader.astro";
import ProofBar from "~/components/ProofBar.astro";
import WorldMap from "~/components/WorldMap.astro";
import CTABanner from "~/components/CTABanner.astro";
import HeroVisual from "~/components/HeroVisual.astro";
import FAQ from "~/components/FAQ.astro";
import PartnersStrip from "~/components/PartnersStrip.astro";
import AskAISection from "~/components/AskAISection.astro";
import CaseStudyCarousel from "~/components/CaseStudyCarousel.astro";
import { getCollection } from "astro:content";

// Pesca case studies featured + più recenti, mappa nel formato Jet card.
const allCases = (await getCollection("caseStudies")).filter((c) => c.data.lang === "it" && !c.data.draft);
const photoMap: Record<string, string> = {
  "40factory": "/testimonials/margherita-chifari-40factory.webp",
  aegis: "/testimonials/aegis_vittorio_maiani.webp",
  apraise: "/testimonials/jacopo-castano-apraise.webp",
  cxl: "/testimonials/brian-dandelet-cxl.webp",
  frh: "/testimonials/fabricio-carminati-frh.webp",
  liftt: "/testimonials/alberto-burzio-liftt.webp",
  navily: "/testimonials/edouard-fiess-navily.webp",
  numeraria: "/testimonials/elisa-gnan-numeraria.webp",
  "oggi-lavoro": "/testimonials/francesca-sorrentino-oggi-lavoro.webp",
  rainplan: "/testimonials/amanda-potter-rainplan.webp",
  "stars-be-original": "/testimonials/gabriella-bruzzone-stars.webp",
  "startup-govtech": "/testimonials/govtech-startup.webp",
  storywonder: "/testimonials/rolf-storywonder.webp",
  "talent-match": "/testimonials/guillem-llacuna-talent-match.webp",
};
const carouselItems = allCases
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.pubDate.getTime() - a.data.pubDate.getTime();
  })
  .slice(0, 9)
  .map((c) => ({
    slug: c.id,
    client: c.data.client,
    clientLogo: c.data.clientLogo,
    quote: c.data.shortQuote || c.data.heroQuote.slice(0, 140) + (c.data.heroQuote.length > 140 ? "…" : ""),
    dimensioni: c.data.dimensioni,
    sector: c.data.sector,
    cardImage: c.data.cardImage || photoMap[c.id],
  }));

const title = "Soraia. Portiamo gli Agenti IA nelle PMI Italiane";
const description =
  "Non software che il tuo team deve imparare a usare. Agenti IA che eseguono i tuoi processi. Misuriamo il tempo recuperato, se non funziona, non paghi.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.soraia.io/#organization",
  name: "Soraia",
  legalName: "Soraia S.r.l.",
  url: "https://www.soraia.io",
  logo: "https://www.soraia.io/logos/soraia-full.svg",
  description,
  email: "info@soraia.io",
  vatID: "IT02820060024",
  foundingDate: "2023",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Via Losana 13",
    addressLocality: "Biella",
    postalCode: "13900",
    addressRegion: "BI",
    addressCountry: "IT",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 45.5648864,
    longitude: 8.0542568,
  },
  areaServed: ["IT", "EU"],
  founder: [
    { "@type": "Person", name: "Daniel Levis", jobTitle: "CEO" },
    { "@type": "Person", name: "Davide Silvestri", jobTitle: "CTO" },
  ],
  sameAs: ["https://www.linkedin.com/company/soraia-digital"],
};

// Due file che scorrono in direzioni opposte. La prima è quella che si vede per prima
// al caricamento: ordine deciso da Daniel (2026-10-17).
const homeLogosA = [
  { name: "APraise", src: "/logos/clients/apraise.webp" },
  { name: "Beta Imprese", src: "/logos/clients/betaimprese.webp" },
  { name: "Lanificio TG", src: "/logos/clients/lanificio-tg.webp" },
  { name: "Banca Sella", src: "/logos/clients/banca-sella.webp" },
  { name: "ESCP", src: "/logos/clients/escp.webp" },
  { name: "Liftt", src: "/logos/clients/liftt.webp" },
  { name: "Stars Be Original", src: "/logos/clients/starsbeoriginal.webp" },
  { name: "Numeraria", src: "/logos/clients/numeraria.webp" },
];
const homeLogosB = [
  { name: "Talent Match", src: "/logos/clients/talentmatch.webp" },
  { name: "Rainplan", src: "/logos/clients/rainplan.webp" },
  { name: "KB&B", src: "/logos/clients/kbb.webp" },
  { name: "StoryWonder", src: "/logos/clients/storywonder.webp" },
  { name: "CXL", src: "/logos/clients/cxl.webp" },
  { name: "Navily", src: "/logos/clients/navily.webp" },
  { name: "French Riviera Househunting", src: "/logos/clients/frh.webp" },
  { name: "ILTEC", src: "/logos/clients/iltec.webp" },
  { name: "Lyra", src: "/logos/clients/logo-lyra.webp" },
  { name: "Por Tier", src: "/logos/clients/por-tier-logo.webp" },
];

const partners = [
  // LLM & AI providers
  { name: "Anthropic", src: "/logos/tools/anthropic.svg" },
  { name: "OpenAI", src: "/logos/tools/openai.svg" },
  { name: "Mistral", src: "/logos/tools/mistral.svg" },
  { name: "Google", src: "/logos/tools/google.svg" },
  // Automation
  { name: "Make", src: "/logos/tools/make.svg" },
  { name: "n8n", src: "/logos/tools/n8n.svg" },
  { name: "Zapier", src: "/logos/tools/zapier.svg" },
  // CRM & business tools
  { name: "HubSpot", src: "/logos/tools/hubspot.svg" },
  { name: "Salesforce", src: "/logos/tools/salesforce.svg" },
  { name: "Pipedrive", src: "/logos/tools/pipedrive.svg" },
  // Productivity & collab
  { name: "Slack", src: "/logos/tools/slack.svg" },
  { name: "Microsoft", src: "/logos/tools/microsoft.svg" },
  { name: "Notion", src: "/logos/tools/notion.svg" },
  { name: "Airtable", src: "/logos/tools/airtable.svg" },
  { name: "Dropbox", src: "/logos/tools/dropbox.svg" },
  { name: "Asana", src: "/logos/tools/asana.svg" },
  // Dev & infra
  { name: "GitHub", src: "/logos/tools/github.svg" },
  { name: "AWS", src: "/logos/tools/aws.svg" },
  { name: "Cloudflare", src: "/logos/tools/cloudflare.svg" },
  // No-code / backend
  { name: "Xano", src: "/logos/tools/xano.webp" },
  { name: "WeWeb", src: "/logos/tools/weweb.svg" },
  // Commerce & ops
  { name: "Stripe", src: "/logos/tools/stripe.svg" },
  { name: "Shopify", src: "/logos/tools/shopify.svg" },
  { name: "Mailchimp", src: "/logos/tools/mailchimp.svg" },
  { name: "Calendly", src: "/logos/tools/calendly.svg" },
];


// Regional dots. Europa raggruppata, altre regioni singole
const worldRegions = [
  {
    x: 50.5, y: 36,
    label: "Europa",
    flag: "🇪🇺",
    total: 28,
    countries: [
      { flag: "🇮🇹", name: "Italia", count: 12 },
      { flag: "🇨🇭", name: "Svizzera", count: 3 },
      { flag: "🇫🇷", name: "Francia", count: 3 },
      { flag: "🇬🇧", name: "Inghilterra", count: 3 },
      { flag: "🇪🇸", name: "Spagna", count: 2 },
      { flag: "🇳🇱", name: "Paesi Bassi", count: 2 },
      { flag: "🇩🇪", name: "Germania", count: 2 },
      { flag: "🇵🇹", name: "Portogallo", count: 1 },
    ],
    align: "right" as const,
  },
  {
    x: 23, y: 40,
    label: "Stati Uniti",
    flag: "🇺🇸",
    total: 7,
    countries: [
      { flag: "🇺🇸", name: "USA", count: 7 },
    ],
    align: "left" as const,
  },
  {
    x: 60, y: 49,
    label: "Emirati Arabi",
    flag: "🇦🇪",
    total: 4,
    countries: [
      { flag: "🇦🇪", name: "UAE", count: 4 },
    ],
  },
  {
    x: 84, y: 71,
    label: "Australia",
    flag: "🇦🇺",
    total: 2,
    countries: [
      { flag: "🇦🇺", name: "Australia", count: 2 },
    ],
    align: "right" as const,
  },
];

const faqs = [
  {
    q: "Cosa fa Soraia in 30 secondi?",
    a: "Siamo un'<strong>AI Agency italiana</strong> con clienti in 11 paesi. Lavoriamo su due fronti: <strong>AI Agents</strong> (costruiamo agenti IA che eseguono i tuoi processi end-to-end) e <strong>AI Adoption</strong> (formiamo il team perché capisca cosa cambia). Prima delivery in 4 settimane. Se non funziona, non paghi.",
  },
  {
    q: "Quanto costa iniziare?",
    a: "Da <strong>3.000 € al mese</strong>, IVA esclusa. Un modello unico e semplice: due figure dedicate sul progetto, un Project Manager e un AI Engineer, con un monte ore combinato al mese. Il prezzo sale solo se servono più ore. Muovi lo slider e vedi il prezzo nella <a href='/prezzi' style='color: var(--color-brand); text-decoration: underline;'>pagina Prezzi</a>.",
  },
  {
    q: "Per chi è pensato?",
    a: "<strong>PMI italiane e team da 10 a 200 persone</strong> in settori dove i processi ripetitivi consumano la maggior parte del tempo del team: recruitment, studi commercialisti, marketing, customer ops, real estate, financial services. Se il tuo team passa più del 30% del tempo su attività ripetitive, abbiamo qualcosa per te.",
  },
  {
    q: "In quanto tempo si vedono risultati?",
    a: "<strong>4 settimane dal go al primo agente in produzione</strong>. Settimana 1: discovery + baseline misurata. Settimane 2-3: build. Settimana 4: deploy + training del team + prima misurazione. <strong>30 giorni di affiancamento inclusi</strong> dopo il go-live. Per AI Adoption: programma da 6 settimane (Foundation) a 4 mesi (con Brain Pilot).",
  },
  {
    q: "Come funziona il primo step?",
    a: "Si parte con una <strong>call gratuita di 20 minuti</strong> con il CEO Daniel, nessun pitch, solo capire se ha senso parlarci. Se c'è un caso d'uso concreto, definiamo insieme il perimetro e le ore che servono davvero, poi partiamo con le due figure dedicate e le prime milestone (<a href='/downloads/ai-assessment-sample' style='color: var(--color-brand); text-decoration: underline;'>vedi un esempio di analisi iniziale</a>). Le milestone e i rilasci sono l'obbligo di risultato: li approvi tu.",
  },
];
---

<Layout title={title} description={description} lang="it" jsonLd={jsonLd}>
  <!-- ============================================================
       1. HERO DEEP PURPLE
       ============================================================ -->
  <section class="relative overflow-hidden bg-hero-dark">

    <div class="container-soraia pt-16 md:pt-24 pb-20 md:pb-28 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-20 items-center min-h-[60vh]">
        <!-- Left: copy -->
        <div class="text-white max-w-2xl">
          <p class="inline-flex items-center gap-2 text-[11px] font-medium tracking-[0.15em] uppercase text-violet-200 mb-6 fade-up">
            <span class="w-1 h-1 rounded-full bg-amber"></span>
            AI Agency · Italia · Clienti globali
          </p>

          <h1 class="text-white text-balance fade-up fade-up-delay-1" style="font-size: clamp(2.5rem, 5vw + 1rem, 4.25rem); line-height: 1.05; letter-spacing: -0.025em; font-weight: 500;">
            Portiamo gli Agenti&nbsp;IA<br/>nelle PMI Italiane.
          </h1>

          <p class="mt-7 text-[18px] md:text-[19px] text-violet-100/85 leading-relaxed max-w-xl fade-up fade-up-delay-2 text-pretty">
            Agenti IA che eseguono i tuoi processi end-to-end. Non software che il tuo team deve imparare a usare. Prima delivery in 4 settimane.
          </p>

          <!-- HARD NUMBERS BAND, upfront credibility -->
          <div class="mt-8 grid grid-cols-3 gap-3 max-w-xl fade-up fade-up-delay-2">
            <div>
              <p class="text-white font-medium" style="font-size: clamp(1.5rem, 2.5vw + 0.5rem, 2rem); line-height: 1; letter-spacing: -0.02em;">70%</p>
              <p class="text-[12px] text-violet-200/70 mt-2 leading-snug">tempo recuperato<br/>medio per processo</p>
            </div>
            <div>
              <p class="text-white font-medium" style="font-size: clamp(1.5rem, 2.5vw + 0.5rem, 2rem); line-height: 1; letter-spacing: -0.02em;">40+</p>
              <p class="text-[12px] text-violet-200/70 mt-2 leading-snug">progetti<br/>consegnati</p>
            </div>
            <div>
              <p class="text-white font-medium" style="font-size: clamp(1.5rem, 2.5vw + 0.5rem, 2rem); line-height: 1; letter-spacing: -0.02em;">4 sett.</p>
              <p class="text-[12px] text-violet-200/70 mt-2 leading-snug">al primo<br/>agente live</p>
            </div>
          </div>

          <!-- GARANZIA BADGE -->
          <div class="mt-7 inline-flex items-center gap-2 fade-up fade-up-delay-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#F4B842" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L4 6v6c0 5 3.5 9.5 8 10 4.5-.5 8-5 8-10V6l-8-4z"/><path d="M9 12l2 2 4-4"/>
            </svg>
            <span class="text-[14px] text-amber font-medium">Se non funziona, non paghi. Garanzia inclusa.</span>
          </div>

          <!-- CTA + CEO CHIP -->
          <div class="mt-9 flex flex-col sm:flex-row gap-3 fade-up fade-up-delay-3">
            <a href="/parliamone" class="btn btn-primary !bg-white !text-violet-900 hover:!bg-violet-50">
              20 min con Daniel
              <span class="btn-arrow">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </span>
            </a>
            <a href="#come-iniziare" class="btn btn-secondary !bg-transparent !text-white !border-white/25 hover:!bg-white/10 hover:!border-white/40">
              Vedi le soluzioni
            </a>
          </div>

          <!-- VOLTI DEL TEAM + STRISCIA DI FIDUCIA (come complaion: le persone subito in hero) -->
          <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-5 fade-up fade-up-delay-4">
            <div class="flex items-center flex-shrink-0">
              {["daniel-levis", "veronica-pisana", "eleonora-cogo", "lorenzo-barbaglia", "davide-silvestri", "martina-rochstein", "paolo-bacchetti"].map((slug, i) => (
                <img src={`/team/${slug}.webp?v=4`} alt="" loading="eager" width="40" height="40" class={`w-10 h-10 rounded-full object-cover ring-2 ring-[#1A0820] ${i === 0 ? "" : "-ml-2.5"}`} />
              ))}
            </div>
            <a href="/parliamone" class="inline-flex items-center text-[13px] leading-tight no-underline group">
              <span class="block">
                <span class="block text-white/90 font-medium">Più di 10 persone, 100% remote. Ti rispondiamo entro 24 ore.</span>
                <span class="block text-violet-200/60 group-hover:text-violet-200/90 transition-colors">Capiamo insieme se ha senso. Senza pitch.</span>
              </span>
            </a>
          </div>
        </div>

        <!-- Right: visual -->
        <div class="lg:justify-self-end w-full fade-up fade-up-delay-2">
          <HeroVisual />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2. TRUSTED BY, proof bar + featured-in
       ============================================================ -->
  <ProofBar label="Si fidano di noi" rowA={homeLogosA} rowB={homeLogosB} />

  <!-- ============================================================
       2a-bis. POSIZIONAMENTO PMI, sfondo tech + griglia, facce del team
       ============================================================ -->
  <section class="section bg-tech-grid relative overflow-hidden">
    <div class="container-soraia">
      <div class="max-w-3xl mx-auto text-center">
        <p class="eyebrow mb-5">Per le PMI in crescita</p>
        <h2 class="text-balance font-medium tracking-tight" style="font-size: clamp(1.875rem, 3vw + 0.5rem, 3rem); line-height: 1.1; color: var(--color-ink);">
          La soluzione ideale per le PMI italiane.
        </h2>
        <p class="mt-5 text-[17px] md:text-[18px] leading-relaxed text-pretty mx-auto max-w-2xl" style="color: var(--color-ink-muted);">
          Pensata per le aziende che non hanno un team di AI engineer interno, ma sanno che sfruttare gli agenti IA apre porte: più tempo sottratto ai processi ripetitivi, meno errori, operazioni che scalano. Noi mettiamo il team e il metodo, tu i risultati.
        </p>
      </div>

      <div class="mt-11 flex flex-col items-center gap-4">
        <div class="flex items-center">
          {["daniel-levis", "eleonora-cogo", "lorenzo-barbaglia", "veronica-pisana", "davide-silvestri", "martina-rochstein", "mohamed-mejri"].map((slug, i) => (
            <img src={`/team/${slug}.webp?v=4`} alt="" loading="lazy" width="44" height="44" class={`w-11 h-11 rounded-full object-cover border-2 border-white ${i === 0 ? "" : "-ml-3"}`} style="box-shadow: var(--shadow-sm);" />
          ))}
        </div>
        <p class="text-[15px] md:text-[16px] font-medium text-center" style="color: var(--color-ink);">
          Siamo un team di persone che sa come lavora una PMI.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2b. DUE MODI DI PARTIRE, routing per situazione del cliente
       ============================================================ -->
  <section id="come-iniziare" class="section bg-white">
    <div class="container-soraia">
      <SectionHeader
        title="Da dove partire dipende da te."
        subtitle="Alcune aziende sanno già cosa automatizzare. Altre sanno di volerlo fare, ma non da dove cominciare. Per entrambe c'è un punto di partenza preciso."
        align="center"
      />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto">
        <!-- A: Sviluppo -->
        <div class="card-editorial reveal !p-8 md:!p-10 flex flex-col">
          <span class="text-[13px] font-semibold text-ink-500 mb-4">AI engineering</span>
          <h3 class="font-medium tracking-tight leading-[1.12] text-ink-900 mb-3" style="font-size: clamp(1.4rem, 2vw + 0.4rem, 1.9rem);">
            Hai già le idee chiare
          </h3>
          <p class="text-[16px] text-ink-700 leading-relaxed text-pretty mb-7 flex-1">
            Sai quali processi automatizzare e dove l'intelligenza artificiale porta valore. I colli di bottiglia li hai già individuati. Li costruiamo in sprint iterativi.
          </p>
          <a href="/ai-engineering" class="btn btn-ghost btn-arrow self-start !px-0" style="color: var(--color-brand);">
            Scopri l'AI engineering
            <span class="btn-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span>
          </a>
        </div>

        <!-- B: Analisi dei processi (evidenziata) -->
        <div class="card-editorial reveal reveal-delay-1 !p-8 md:!p-10 flex flex-col" style="border: 2px solid var(--color-brand); background: var(--color-violet-50, #FDF4FF);">
          <span class="text-[13px] font-semibold mb-4" style="color: var(--color-brand-accent);">Analisi dei processi</span>
          <h3 class="font-medium tracking-tight leading-[1.12] text-ink-900 mb-3" style="font-size: clamp(1.4rem, 2vw + 0.4rem, 1.9rem);">
            Vuoi sfruttare l'AI, ma non sai da dove partire
          </h3>
          <p class="text-[16px] text-ink-700 leading-relaxed text-pretty mb-7 flex-1">
            Prima capiamo come lavori davvero, poi decidiamo cosa costruire. L'analisi individua dove automazione e AI portano più valore, prima di spendere in sviluppo.
          </p>
          <a href="/analisi-processi" class="btn btn-primary btn-arrow self-start">
            Scopri l'analisi dei processi
            <span class="btn-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2c. DOPO IL NOSTRO INTERVENTO, outcome / benefici
       ============================================================ -->
  <section class="section bg-hero-dark relative overflow-hidden">
    <div class="container-soraia relative z-10">
      <SectionHeader
        eyebrow="Dopo il nostro intervento"
        title="Un'azienda con costi operativi più bassi, che dipende meno da te e vale di più."
        subtitle="Mettiamo ordine nei processi e li automatizziamo con software su misura e agenti AI, che restano di proprietà della tua azienda."
        align="center"
        variant="dark"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-7 max-w-5xl mx-auto">
        <div class="dk-card reveal">
          <span class="dk-chip">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </span>
          <h3 class="font-medium tracking-tight mb-2.5" style="font-size: 1.3rem; color: #fff;">Meno lavoro ripetitivo</h3>
          <p class="text-[15.5px] leading-relaxed" style="color: rgba(255,255,255,0.75);">Inserimento dati, controlli, riconciliazioni e report li fa il software. Le stesse persone gestiscono più volume e l'azienda cresce senza far crescere l'amministrazione.</p>
        </div>
        <div class="dk-card reveal reveal-delay-1">
          <span class="dk-chip">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>
          </span>
          <h3 class="font-medium tracking-tight mb-2.5" style="font-size: 1.3rem; color: #fff;">Non sei più il collo di bottiglia</h3>
          <p class="text-[15.5px] leading-relaxed" style="color: rgba(255,255,255,0.75);">I processi chiari si delegano. Le attività di routine non passano più da te, l'azienda si managerializza e tu torni a guidarla invece di rincorrerla.</p>
        </div>
