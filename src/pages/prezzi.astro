---
import Layout from "~/layouts/Layout.astro";
import PricingCalculator from "~/components/PricingCalculator.tsx";
import SectionHeader from "~/components/SectionHeader.astro";

const title = "Prezzi | Soraia";
const description =
  "Prezzi semplici e trasparenti: due figure dedicate (Project Manager e AI Engineer), ore al mese combinate, a partire da 3.000 euro al mese. Sposta lo slider e vedi il prezzo.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  url: "https://www.soraia.io/prezzi",
  inLanguage: "it-IT",
};

---

<Layout title={title} description={description} lang="it" jsonLd={jsonLd} altHref="/en/contact">
  <!-- HERO -->
  <section class="relative overflow-hidden bg-violet-mesh">
    <div class="orb orb-violet w-[500px] h-[500px] -top-32 -right-20 opacity-40 float-slow" aria-hidden="true"></div>
    <div class="container-soraia pt-16 md:pt-24 pb-8 md:pb-10 relative z-10 text-center max-w-2xl">
      <p class="eyebrow mb-5">Prezzi</p>
      <h1 class="text-[2.5rem] sm:text-[3.25rem] md:text-[3.75rem] font-semibold tracking-tight text-ink-900 leading-[1.04] text-balance">
        Prezzi semplici e trasparenti
      </h1>
      <p class="mt-6 text-[18px] md:text-[20px] text-ink-700 leading-relaxed text-pretty">
        Due figure dedicate sul tuo progetto, a partire da 3.000 euro al mese. Anche solo per un mese, senza vincoli di durata. Sposta lo slider e scopri il prezzo.
      </p>
    </div>
  </section>

  <!-- CALCULATOR -->
  <section class="section pt-8 md:pt-10">
    <div class="container-soraia">
      <PricingCalculator client:load />
    </div>
  </section>

  <!-- 4 SETTIMANE IN PRODUZIONE -->
  <section class="section pt-0">
    <div class="container-soraia">
      <div class="rounded-3xl p-8 md:p-14 text-center" style="background: var(--color-brand); color: #fff;">
        <p class="eyebrow mb-4" style="color: rgba(255,255,255,0.7);">La differenza</p>
        <h2 class="text-balance mx-auto max-w-3xl" style="font-size: clamp(1.875rem, 3vw + 0.5rem, 3rem); line-height: 1.08; letter-spacing: -0.025em; font-weight: 500; color: #fff;">
          In 4 settimane sei già in produzione
        </h2>
        <p class="mt-5 text-[17px] md:text-[19px] leading-relaxed text-pretty max-w-2xl mx-auto" style="color: rgba(255,255,255,0.82);">
          Molte agenzie, dopo quattro settimane, non ti hanno ancora mandato il preventivo. Con noi, nello stesso mese, il primo rilascio gira già sui tuoi processi reali.
        </p>
      </div>
    </div>
  </section>

  <!-- METODOLOGIA (sprint methodology) -->
  <section class="section bg-white border-t border-line">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="Metodologia"
        title="Come costruiamo i tuoi agenti IA."
        subtitle="<strong>Sprint iterativi corti</strong>: ad ogni iterazione l'agente fa già qualcosa di utile in produzione. Niente progetti di 6 mesi che finiscono in un demo: vedi valore già dalla prima settimana."
        align="center"
      />

      <!-- Sprint diagram (hero visual, centered) -->
      <figure class="m-0 mt-8 max-w-[1180px] mx-auto">
        <div class="rounded-2xl bg-ink-50 border border-line px-4 py-6 md:px-8 md:py-8">
          <img
            src="/agile/sprint.webp"
            alt="Sprint iterativi: ogni ciclo consegna valore in produzione"
            loading="lazy"
            decoding="async"
            class="w-full h-auto block"
          />
        </div>
        <figcaption class="mt-3.5 text-[12.5px] text-center" style="color: var(--color-ink-soft);">
          Sprint iterativi: ad ogni ciclo l'agente è già in produzione.
        </figcaption>
      </figure>

      <!-- Sprint steps timeline 4-col -->
      <div class="mt-14 md:mt-16 max-w-6xl mx-auto">
        <ol class="sprint-timeline">
          <li class="sprint-step">
            <div class="sprint-step-head">
              <span class="sprint-num">1</span>
              <div class="sprint-step-meta">
                <p class="sprint-step-tag">Settimana 1</p>
                <p class="sprint-step-title">Discovery + baseline</p>
              </div>
            </div>
            <p class="sprint-step-body">Cronometriamo il processo target con il tuo team. Lock del <strong>metric primario unico</strong> (es. ore/persona/settimana recuperate). Senza baseline, niente garanzia.</p>
          </li>
          <li class="sprint-step">
            <div class="sprint-step-head">
              <span class="sprint-num">2</span>
              <div class="sprint-step-meta">
                <p class="sprint-step-tag">Settimane 2-3</p>
                <p class="sprint-step-title">Build dell'agente</p>
              </div>
            </div>
            <p class="sprint-step-body">Prompt engineering, integrazione con i tuoi sistemi (CRM, ATS, gestionali), regole di escalation, audit log. Review settimanali con il tuo team operativo.</p>
          </li>
          <li class="sprint-step">
            <div class="sprint-step-head">
              <span class="sprint-num">3</span>
              <div class="sprint-step-meta">
                <p class="sprint-step-tag">Settimana 4</p>
                <p class="sprint-step-title">Shadow mode + training</p>
              </div>
            </div>
            <p class="sprint-step-body">L'agente lavora in parallelo al team umano, senza ancora prendere decisioni autonome. Confronto output, fine-tuning sui criteri, formazione del team.</p>
          </li>
          <li class="sprint-step sprint-step--milestone">
            <div class="sprint-step-head">
              <span class="sprint-num sprint-num--milestone">4</span>
              <div class="sprint-step-meta">
                <p class="sprint-step-tag">Go-live + 30 gg</p>
                <p class="sprint-step-title">Hypercare e misurazione</p>
              </div>
            </div>
            <p class="sprint-step-body">L'agente passa in produzione. Monitoring attivo Soraia per 30 giorni, fix immediati sui casi limite. Al giorno 30: <strong>misurazione finale vs baseline</strong>. Se non hai recuperato le ore promesse, non paghi lo sprint.</p>
          </li>
        </ol>

        <div class="mt-12 flex justify-center">
          <div class="inline-flex items-center gap-2.5 px-5 py-3 rounded-full text-[13px] font-medium" style="background: var(--color-brand-soft); color: var(--color-brand); border: 1px solid var(--color-violet-200);">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span><strong>4 settimane</strong> al primo agente live · iterazioni mensili dopo il go-live</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PORTALE CLIENTE -->
  <section class="section pt-0">
    <div class="container-soraia max-w-3xl text-center">
      <p class="eyebrow mb-4">Trasparenza</p>
      <h2 class="text-balance" style="font-size: clamp(1.75rem, 3vw + 0.5rem, 2.25rem); line-height: 1.15; letter-spacing: -0.025em; font-weight: 500;">Vedi ore e avanzamento in tempo reale</h2>
      <p class="mt-4 text-[17px] leading-relaxed text-pretty" style="color: var(--color-ink-muted);">
        Ogni cliente ha un portale dedicato: ore lavorate per sprint e per persona, stato di ogni ticket, tutto aggiornato in tempo reale. Niente scatola nera, niente report da chiedere.
      </p>
      <div class="mt-7">
        <a href="/demo-portale" class="btn btn-primary">
          Prova il portale, demo
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container-soraia max-w-2xl text-center">
      <h2 class="text-balance" style="font-size: clamp(1.75rem, 3vw + 0.5rem, 2.25rem); line-height: 1.15; letter-spacing: -0.025em; font-weight: 500;">Partiamo da una conversazione, non da un preventivo</h2>
      <p class="mt-4 text-[17px] leading-relaxed text-pretty" style="color: var(--color-ink-muted);">
        Mezz'ora per capire il problema, il perimetro e quante ore servono davvero nel tuo caso. Senza impegno.
      </p>
      <div class="mt-7">
        <a href="/parliamone" class="btn btn-primary">
          20 min con Daniel
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  /* The element is as tall as the thumb; the 6px fill line is painted as the
     background, vertically centered, so the thumb sits exactly on the line. */
  .pricing-range {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 26px;
    background-color: transparent;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100% 6px;
    border-radius: 999px;
    outline: none;
    cursor: pointer;
  }
  .pricing-range::-webkit-slider-runnable-track {
    -webkit-appearance: none;
    height: 6px;
    background: transparent;
    border-radius: 999px;
  }
  .pricing-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    box-sizing: border-box;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--color-brand);
    box-shadow: 0 2px 10px rgba(74, 30, 92, 0.3);
    cursor: pointer;
    margin-top: -10px; /* (6 - 26) / 2: centra il cerchio sulla linea da 6px */
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .pricing-range:hover::-webkit-slider-thumb { transform: scale(1.08); }
  .pricing-range:active::-webkit-slider-thumb {
    transform: scale(1.12);
    box-shadow: 0 3px 14px rgba(74, 30, 92, 0.4);
  }
  .pricing-range::-moz-range-track {
    height: 6px;
    border-radius: 999px;
    background: transparent;
  }
  .pricing-range::-moz-range-thumb {
    box-sizing: border-box;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--color-brand);
    box-shadow: 0 2px 10px rgba(74, 30, 92, 0.3);
    cursor: pointer;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .pricing-range:hover::-moz-range-thumb { transform: scale(1.08); }
  .pricing-range:active::-moz-range-thumb {
    transform: scale(1.12);
    box-shadow: 0 3px 14px rgba(74, 30, 92, 0.4);
  }

  /* === Sprint timeline (metodologia) === */
  .sprint-timeline {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }
  @media (min-width: 768px) {
    .sprint-timeline {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 2rem;
    }
  }
  @media (min-width: 1024px) {
    .sprint-timeline {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
    .sprint-timeline::before {
      content: "";
      position: absolute;
      top: 22px;
      left: 7%;
      right: 7%;
      height: 2px;
      background: linear-gradient(to right,
        var(--color-line-strong) 0%,
        var(--color-violet-300) 50%,
        var(--color-brand) 100%);
      opacity: 0.5;
      z-index: 0;
    }
  }
  .sprint-step {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sprint-step-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  @media (min-width: 1024px) {
    .sprint-step-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.1rem;
    }
  }
  .sprint-num {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    background: white;
    border: 1.5px solid var(--color-violet-300);
    color: var(--color-brand);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: -0.01em;
    box-shadow: 0 0 0 8px white;
  }
  .sprint-num--milestone {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: white;
    box-shadow: 0 0 0 8px white, 0 4px 14px -4px rgba(74, 30, 92, 0.40);
  }
  .sprint-step-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .sprint-step-tag {
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    line-height: 1.4;
  }
  .sprint-step-title {
    font-size: 15.5px;
    line-height: 1.25;
    letter-spacing: -0.015em;
    font-weight: 500;
    color: var(--color-ink);
  }
  .sprint-step-body {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin: 0;
    text-wrap: pretty;
  }
  .sprint-step-body strong {
    color: var(--color-ink);
    font-weight: 500;
  }
  .sprint-step--milestone .sprint-step-title {
    color: var(--color-brand);
  }
</style>
