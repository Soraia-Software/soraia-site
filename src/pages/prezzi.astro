const sicurezzaBase = [
  "Crittografia dei dati in transito e a riposo",
  "Backup e accessi per ruolo",
  "Sviluppo secondo le best practice OWASP",
  "Cifratura dei campi sensibili, log di audit, policy di conservazione",
  "Test di carico, monitoraggio e SLA di disponibilità",
  "Codice e dati su account intestati a te",
];

const sicurezzaPlus = [
  "Documentazione tecnica per DPO e legale",
  "Conformità all’AI Act: rischio, documentazione, trasparenza",
  "Dossier pronto per auditor ed enti di certificazione",
  "Pentest esterno prima del rilascio, con report",
];

const regole = [
  {
    title: "Lo Sprint Goal è il patto del mese",
    body: "Lo scriviamo insieme e lo approvi tu. È il riferimento per capire cosa è stato consegnato.",
  },
  {
