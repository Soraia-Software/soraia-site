    items: [
      "Monitoraggio e correzione dei malfunzionamenti",
      "Aggiornamenti di sicurezza e tecnici",
      "Test mensile delle risposte degli agenti IA su casi reali",
      "Ottimizzazione delle istruzioni quando la qualità cala",
      "Controllo dei costi delle API, con avvisi",
      "Report mensile su sicurezza, prestazioni e utilizzo reale",
      "Proposte di miglioramento per i prossimi Sprint",
    ],
    foot: "Il prezzo dipende da utenti e integrazioni. Le nuove funzionalità entrano in uno Sprint.",
    cta: "Parliamone",
    featured: false,
  },
];

const addons = [
  {
    name: "Compliance & Audit",
    price: "4.000€",
    unit: " una tantum",
    claim: "Per dimostrare che il software è conforme, a chi te lo chiede",
    items: [
      "Documentazione tecnica per DPO e legale: misure art. 32 GDPR, supporto alla DPIA, mappa dei flussi di dati",
      "Conformità all’AI Act: classificazione del rischio, documentazione tecnica, trasparenza verso gli utenti e sorveglianza umana",
      "Dossier di conformità pronto da consegnare a un auditor o da allegare a una certificazione",
    ],
  },
  {
    name: "Pentest",
    price: "4.000€",
    unit: " una tantum",
    claim: "Per dimostrare che il software regge un attacco",
    items: [
      "Test di sicurezza eseguito da un partner esterno prima del rilascio",
      "Report consegnabile ad auditor, clienti e assicurazione",
      "Correzione delle vulnerabilità critiche inclusa",
    ],
  },
  {
