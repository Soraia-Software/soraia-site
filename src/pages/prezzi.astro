---
import Layout from "~/layouts/Layout.astro";
import PricingCalculator from "~/components/PricingCalculator.tsx";

const title = "Prezzi | Soraia";
const description =
  "Prezzi semplici e trasparenti: due figure dedicate (Project Manager e AI Engineer), ore al mese combinate, a partire da 3.000 euro al mese. Sposta lo slider e vedi il prezzo.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  url: "https://www.soraia.io/prezzi",
  inLanguage: "it-IT",
};

const steps = [
  {
    tag: "Settimana 1",
    t: "Discovery e baseline",
    d: "Entriamo nei tuoi processi con il tuo team e fissiamo il risultato da raggiungere e come si misura. Senza una baseline chiara non c'è garanzia.",
  },
  {
    tag: "Settimane 2-3",
    t: "Costruzione",
    d: "Le due figure dedicate costruiscono e integrano sui tuoi sistemi, dal CRM ai gestionali ai dati. Un punto di avanzamento ogni settimana e la dashboard di progetto sempre aperta.",
  },
  {
    tag: "Settimana 4",
    t: "Rilascio in produzione",
    d: "Il primo rilascio va live sui tuoi processi reali, con la formazione del team. In un mese hai qualcosa che gira davvero sui tuoi dati.",
  },
  {
    tag: "Go-live + 30 giorni",
    t: "Hypercare e ritmo mensile",
    d: "Ti seguiamo sui casi reali e misuriamo contro la baseline. Poi si prosegue mese per mese, con le milestone e i rilasci che approvi tu.",
  },
];
---

<Layout title={title} description={description} lang="it" jsonLd={jsonLd} altHref="/en/contact">
  <!-- HERO -->
  <section class="relative overflow-hidden bg-violet-mesh">
    <div class="orb orb-violet w-[500px] h-[500px] -top-32 -right-20 opacity-40 float-slow" aria-hidden="true"></div>
    <div class="container-soraia pt-16 md:pt-24 pb-8 md:pb-10 relative z-10 text-center max-w-2xl">
      <p class="eyebrow mb-5">Prezzi</p>
      <h1 class="text-[2.5rem] sm:text-[3.25rem] md:text-[3.75rem] font-semibold tracking-tight text-ink-900 leading-[1.04] text-balance">
        Prezzi semplici e trasparenti
      </h1>
      <p class="mt-6 text-[18px] md:text-[20px] text-ink-700 leading-relaxed text-pretty">
        Due figure dedicate sul tuo progetto, a partire da 3.000 euro al mese. Anche solo per un mese, senza vincoli di durata. Sposta lo slider e scopri il prezzo.
      </p>
    </div>
  </section>

  <!-- CALCULATOR -->
  <section class="section pt-8 md:pt-10">
    <div class="container-soraia">
      <PricingCalculator client:load />
    </div>
  </section>

  <!-- 4 SETTIMANE IN PRODUZIONE -->
  <section class="section pt-0">
    <div class="container-soraia">
      <div class="rounded-3xl p-8 md:p-14 text-center" style="background: var(--color-brand); color: #fff;">
        <p class="eyebrow mb-4" style="color: rgba(255,255,255,0.7);">La differenza</p>
        <h2 class="text-balance mx-auto max-w-3xl" style="font-size: clamp(1.875rem, 3vw + 0.5rem, 3rem); line-height: 1.08; letter-spacing: -0.025em; font-weight: 500; color: #fff;">
          In 4 settimane sei già in produzione
        </h2>
        <p class="mt-5 text-[17px] md:text-[19px] leading-relaxed text-pretty max-w-2xl mx-auto" style="color: rgba(255,255,255,0.82);">
          Molte agenzie, dopo quattro settimane, non ti hanno ancora mandato il preventivo. Con noi, nello stesso mese, il primo rilascio gira già sui tuoi processi reali.
        </p>
      </div>
    </div>
  </section>

  <!-- COME LAVORIAMO -->
  <section class="section pt-4 md:pt-6" style="background: #F3EFF5;">
    <div class="container-soraia">
      <div class="max-w-2xl mb-10">
        <p class="eyebrow mb-4">Come lavoriamo</p>
        <h2 class="text-balance" style="font-size: clamp(1.875rem, 3vw + 0.5rem, 2.5rem); line-height: 1.1; letter-spacing: -0.025em; font-weight: 500;">Dal via alla produzione in quattro settimane</h2>
        <p class="mt-4 text-[17px] leading-relaxed text-pretty" style="color: var(--color-ink-muted);">
          Semplice da seguire per te, con il lavoro tecnico serio sotto il cofano: modello dei dati, integrazioni, agenti AI ottimizzati, test di carico e rilasci controllati. Ecco cosa succede, settimana per settimana.
        </p>
      </div>
      <ol class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {steps.map((s, i) => (
          <li class="card !p-7 flex items-start gap-4">
            <span class="flex-shrink-0 inline-flex w-10 h-10 rounded-full items-center justify-center text-[15px] font-semibold" style="background: var(--color-brand); color: #fff;">{i + 1}</span>
            <div>
              <p class="text-[12px] font-semibold uppercase tracking-[0.12em]" style="color: var(--color-brand);">{s.tag}</p>
              <h3 style="font-size: 1.125rem; letter-spacing: -0.01em; font-weight: 600; line-height: 1.25; margin-top: 2px;">{s.t}</h3>
              <p class="mt-2 text-[14.5px] leading-relaxed text-pretty" style="color: var(--color-ink-muted);">{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="mt-8 flex justify-center">
        <div class="inline-flex items-center gap-2.5 px-5 py-3 rounded-full text-[13.5px] font-medium" style="background: #fff; color: var(--color-brand); border: 1px solid var(--color-violet-200, #E9D5F0);">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span><strong>4 settimane</strong> al primo rilascio in produzione, poi ritmo mensile</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container-soraia max-w-2xl text-center">
      <h2 class="text-balance" style="font-size: clamp(1.75rem, 3vw + 0.5rem, 2.25rem); line-height: 1.15; letter-spacing: -0.025em; font-weight: 500;">Partiamo da una conversazione, non da un preventivo</h2>
      <p class="mt-4 text-[17px] leading-relaxed text-pretty" style="color: var(--color-ink-muted);">
        Mezz'ora per capire il problema, il perimetro e quante ore servono davvero nel tuo caso. Senza impegno.
      </p>
      <div class="mt-7">
        <a href="/parliamone" class="btn btn-primary">
          20 min con Daniel
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .pricing-range {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 999px;
    outline: none;
    cursor: pointer;
  }
  .pricing-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--color-brand);
    box-shadow: 0 2px 10px rgba(74, 30, 92, 0.3);
    cursor: pointer;
    margin-top: -10px;
  }
  .pricing-range::-moz-range-thumb {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--color-brand);
    box-shadow: 0 2px 10px rgba(74, 30, 92, 0.3);
    cursor: pointer;
  }
  .pricing-range::-moz-range-track {
    height: 6px;
    border-radius: 999px;
    background: transparent;
  }
</style>
