---
import Layout from "~/layouts/Layout.astro";
import PathBuilder from "~/components/PathBuilder.tsx";
import SectionHeader from "~/components/SectionHeader.astro";
import FAQ from "~/components/FAQ.astro";
import "~/styles/prezzi.css";

const title = "Prezzi | Soraia";
const description =
  "Un team che dà vita al software di cui hai bisogno. Analisi 3.000 €, Sprint da 8.000 € al mese, Hypercare da 500 €, più gli add-on che servono. Per un lavoro piccolo, pacchetti da 50 o 100 ore.";

const faqs = [
  {
    q: "Perché l’Analisi è a pagamento?",
    a: "Perché è lavoro vero: ne esci con blueprint, priorità e un preventivo a prezzo fisso, che resta tuo anche se decidi di non proseguire. Se parti con lo Sprint entro 30 giorni, i 3.000€ vengono scalati. Non è obbligatoria: se hai già chiaro cosa costruire, si parte direttamente dallo Sprint.",
  },
  {
    q: "Cosa è incluso esattamente in un mese di Sprint?",
    a: "Il team dedicato, il metodo e un rilascio in produzione. Cosa costruire lo definiamo insieme nello Sprint Goal a inizio mese: è il documento che dice cosa arriva.",
  },
  {
    q: "Quando conviene il pacchetto di ore invece dello Sprint?",
    a: "Quando il lavoro è piccolo e circoscritto, e un team continuativo sarebbe sprecato: un’integrazione, una correzione, un modulo che sta in piedi da solo. 50 ore costano 4.000€, 100 ore 7.500€. Se il lavoro cresce, si passa allo Sprint.",
  },
  {
    q: "Senza Compliance & Audit il software è meno sicuro?",
    a: "No. Crittografia, backup, accessi per ruolo, cifratura dei campi sensibili, log di audit, test di carico e SLA sono inclusi in ogni Sprint. Compliance & Audit non aggiunge sicurezza: aggiunge le prove, cioè i documenti che servono a dimostrarla a un auditor, a un ente di certificazione o a un cliente che te li chiede.",
  },
  {
    q: "La documentazione sostituisce il DPO o il legale?",
    a: "No. Prepariamo la documentazione tecnica che il tuo DPO e il tuo legale usano per le loro valutazioni. La valutazione giuridica resta a loro.",
  },
  {
    q: "Cosa fate per l’AI Act?",
    a: "Con Compliance & Audit classifichiamo il livello di rischio del sistema, prepariamo la documentazione tecnica e il registro delle decisioni, rendiamo esplicito all’utente quando sta interagendo con l’AI e documentiamo i punti di sorveglianza umana. Il riferimento è il Regolamento (UE) 2024/1689. Come per il GDPR, la valutazione giuridica resta al tuo legale.",
  },
  {
    q: "Cosa succede se a fine Sprint resta lavoro da fare?",
    a: "Lo trovi nel portale, già in ordine di priorità. Puoi attivare un altro Sprint subito, più avanti o mai: decidi tu.",
  },
  {
    q: "Posso tenere il team tutto l’anno?",
    a: "Sì, ed è il modo in cui lo Sprint è pensato: un team che resta sul tuo progetto mese dopo mese. Per impegni lunghi o più applicativi in parallelo costruiamo un percorso su misura.",
  },
  {
    q: "Chi paga hosting e servizi di AI?",
    a: "Tu, direttamente, su account intestati alla tua azienda. Nessun ricarico, nessuna dipendenza da noi.",
  },
  {
    q: "E se il primo mese non mi convince?",
    a: "Ti rimborsiamo. In alternativa lavoriamo gratis finché non sei soddisfatto.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    url: "https://www.soraia.io/prezzi",
    inLanguage: "it-IT",
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Sviluppo software e agenti IA a Sprint mensili. Soraia",
    provider: { "@type": "Organization", name: "Soraia", url: "https://www.soraia.io" },
    areaServed: "IT",
    serviceType: "Sviluppo software su misura e agenti IA",
    offers: [
      {
        "@type": "Offer",
        name: "Analisi",
        price: "3000",
        priceCurrency: "EUR",
        description:
          "Mappatura dei processi, blueprint del software, priorità e criteri di accettazione, stima in mesi di Sprint e preventivo a prezzo fisso. Facoltativa, scalata dal primo Sprint se parti entro 30 giorni. IVA esclusa.",
      },
      {
        "@type": "Offer",
        name: "Sprint",
        price: "8000",
        priceCurrency: "EUR",
        description:
          "Il team dedicato mese dopo mese: Account Manager, Project Manager e AI Engineer, Sprint Goal firmato a inizio mese, demo a metà mese e rilascio in produzione a fine mese, con cifratura dei campi sensibili, log di audit, test di carico e SLA inclusi. Anche un solo mese. IVA esclusa.",
      },
      {
        "@type": "Offer",
        name: "Hypercare",
        price: "500",
        priceCurrency: "EUR",
        description:
          "Dopo il go-live: monitoraggio, correzione dei malfunzionamenti, aggiornamenti di sicurezza e tecnici, controllo della qualità degli agenti IA e dei costi delle API, report mensile. Facoltativa, contratto annuale. IVA esclusa.",
      },
      {
        "@type": "Offer",
        name: "Compliance & Audit",
        price: "4000",
        priceCurrency: "EUR",
        description:
          "Add-on indipendente, una tantum: documentazione tecnica per DPO e legale su GDPR e AI Act, e un dossier di conformità pronto per auditor ed enti di certificazione. IVA esclusa.",
      },
      {
        "@type": "Offer",
        name: "Pentest",
        price: "4000",
        priceCurrency: "EUR",
        description:
          "Add-on indipendente, una tantum: test di sicurezza eseguito da un partner esterno prima del rilascio, report consegnabile e correzione delle vulnerabilità critiche. IVA esclusa.",
      },
      {
        "@type": "Offer",
        name: "Formazione e adozione",
        price: "3000",
        priceCurrency: "EUR",
        description:
          "Add-on indipendente, una tantum: due sessioni con il team, video tutorial e manuale utente, sessione di verifica dopo 30 giorni. IVA esclusa.",
      },
      {
        "@type": "Offer",
        name: "Supporto bandi",
        price: "2000",
        priceCurrency: "EUR",
        description:
          "Add-on indipendente, una tantum: verifica dei requisiti, preventivo conforme al bando, documentazione tecnica per la domanda e supporto alla rendicontazione. Si paga solo se il bando è vinto. IVA esclusa.",
      },
      {
        "@type": "Offer",
        name: "Pacchetto 50 ore",
        price: "4000",
        priceCurrency: "EUR",
        description:
          "Per un lavoro piccolo e circoscritto, senza team continuativo: 50 ore da usare quando servono. IVA esclusa.",
      },
      {
        "@type": "Offer",
        name: "Pacchetto 100 ore",
        price: "7500",
        priceCurrency: "EUR",
        description:
          "Per un lavoro piccolo e circoscritto, senza team continuativo: 100 ore da usare quando servono. IVA esclusa.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];

const guarantees = [
  {
    text: "Primo mese soddisfatti o rimborsati",
    icon: `<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"></path><path d="M9 12l2 2 4-4"></path>`,
  },
  {
    text: "Anche un solo mese, senza vincolo",
    icon: `<rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M8 3v4"></path><path d="M16 3v4"></path><path d="M3 11h18"></path>`,
  },
  {
    text: "Prezzo fisso o pacchetto di ore, scegli tu",
    icon: `<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 10h18"></path>`,
  },
  {
    text: "Codice e dati su account intestati a te",
    icon: `<rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 018 0v4"></path>`,
  },
  {
    text: "Sicurezza di base sempre inclusa",
    icon: `<path d="M5 12l5 5L20 7"></path>`,
  },
];

const servizi = [
  {
    n: "1",
    name: "Analisi",
    title: "Sai cosa costruire, e quanto costa",
    price: "3.000€",
    unit: " una tantum",
    note: "Facoltativa. Scalata dal primo Sprint se parti entro 30 giorni.",
    items: [
      "Mappatura dei processi con le persone che li vivono",
      "Blueprint del software e scelte tecniche",
      "Priorità e criteri di accettazione scritti",
      "Stima in mesi di Sprint e preventivo a prezzo fisso",
    ],
    cta: "Prenota l’Analisi",
    featured: false,
  },
  {
    n: "2",
    name: "Sprint",
    title: "Il team dedicato, mese dopo mese",
    price: "8.000€",
    unit: " /mese",
    from: true,
    note: "Anche un solo mese, senza vincolo. Pagamento a inizio Sprint.",
    items: [
      "Account Manager, Project Manager e AI Engineer",
      "Sprint Goal concordato e firmato a inizio mese",
      "Demo a metà mese, rilascio in produzione a fine mese",
      "Crittografia dei dati, backup, accessi per ruolo, best practice OWASP",
      "Cifratura dei campi sensibili, log di audit, policy di conservazione e cancellazione",
      "Test di carico, monitoraggio e SLA di disponibilità",
