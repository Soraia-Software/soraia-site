---

<Layout title={title} description={description} lang="it" jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-violet-mesh">
    <div class="orb orb-violet w-[500px] h-[500px] -top-32 -right-20 opacity-40 float-slow" aria-hidden="true"></div>
    <div class="container-soraia pt-16 md:pt-24 pb-14 md:pb-20 relative z-10">
      <p class="eyebrow mb-5">Prezzi</p>
      <h1 class="text-ink text-balance" style="font-size: clamp(2.5rem, 5vw + 1rem, 3.75rem); line-height: 1.05; letter-spacing: -0.025em; font-weight: 500; max-width: 20ch;">
        Un team che dà vita al software di cui hai bisogno.
      </h1>
      <p class="mt-6 text-[17px] md:text-[18px] leading-relaxed text-pretty max-w-2xl" style="color: var(--color-ink-muted);">
        Account Manager, Project Manager e AI Engineer, con un metodo rodato. Tre passi a prezzo fisso, più gli add-on che servono al tuo progetto. Se il lavoro è piccolo, c’è il pacchetto di ore. <a href="/ai-engineering" style="color: var(--color-brand); font-weight: 600;">Come lavoriamo, in dettaglio &rarr;</a>
      </p>
      <ul class="flex flex-wrap gap-3 mt-10 list-none p-0">
        {guarantees.map((g) => (
          <li class="card !py-3.5 !px-5 flex items-center gap-2.5 text-[15px] font-medium">
            <svg class="shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={g.icon} />
            {g.text}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- TRE SERVIZI -->
  <section class="section" id="servizi">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="Come funziona"
        title="Tre passi, ognuno con il suo prezzo fisso"
        subtitle="Parti dall’Analisi se serve, tieni il team per i mesi che vuoi, poi scegli se tenere il software seguito. Prezzi IVA esclusa."
      />

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">
        {servizi.map((s) => (
          <div
            class="card card-hover flex flex-col gap-5 !p-8"
            style={s.featured ? "border: 2px solid var(--color-brand); box-shadow: 0 18px 40px -20px rgba(74,30,92,0.35);" : undefined}
          >
            <div>
              <p class="eyebrow" style="color: var(--color-brand);">{s.n} &middot; {s.name}</p>
              <h3 class="mt-2 text-[1.5rem] font-medium tracking-tight text-balance">{s.title}</h3>
            </div>
            <div>
              {s.from && <span class="text-[15px]" style="color: var(--color-ink-soft);">da </span>}
              <span class="bignum">{s.price}</span><span class="text-[16px]" style="color: var(--color-ink-soft);">{s.unit}</span>
              <p class="text-[14px] mt-1" style="color: var(--color-ink-soft);">{s.note}</p>
            </div>
            <ul class="flex flex-col gap-2.5 text-[15px] list-none p-0 m-0">
              {s.items.map((item) => (
                <li class="flex items-start gap-2.5">
                  <svg class="shrink-0 mt-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            {s.foot && <p class="text-[13.5px]" style="color: var(--color-ink-soft);">{s.foot}</p>}
            <div class="mt-auto"></div>
            <a href="/parliamone" class={`btn ${s.featured ? "btn-primary" : "btn-secondary"} justify-center`}>{s.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ADD-ON -->
  <section class="section" id="add-on" style="background: var(--color-surface);">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="Add-on"
        title="Gli add-on si comprano da soli o insieme ai servizi"
        subtitle="Sono opzionali, si pagano una volta sola e sono indipendenti: non serve aver fatto l’Analisi né avere uno Sprint in corso."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
        {addons.map((a) => (
          <div class="card flex flex-col gap-4 !p-7">
            <div>
              <h3 class="text-[1.25rem] font-medium tracking-tight">{a.name}</h3>
              <div class="mt-1 whitespace-nowrap">
                <span class="bignum" style="font-size: clamp(1.5rem, 2.5vw, 1.75rem);">{a.price}</span><span class="text-[14px]" style="color: var(--color-ink-soft);">{a.unit}</span>
              </div>
            </div>
            <p class="text-[15px]" style="color: var(--color-ink-muted);">{a.claim}</p>
            <ul class="flex flex-col gap-2.5 text-[14.5px] list-none p-0 m-0">
              {a.items.map((item) => (
                <li class="flex items-start gap-2.5">
                  <svg class="shrink-0 mt-1" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            {a.foot && <p class="text-[14px] font-semibold" style="color: var(--color-brand);">{a.foot}</p>}
            {a.cta && <a href={a.cta.href} class="btn btn-secondary mt-auto justify-center">{a.cta.label}</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PACCHETTI A ORE -->
  <section class="section" id="ore">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="Oppure a ore"
        title="Non ti serve un team continuativo? Compra un pacchetto di ore"
        subtitle="Per un lavoro piccolo e circoscritto, dove uno Sprint intero sarebbe troppo: un’integrazione, una correzione, un modulo che sta in piedi da solo. Le ore si usano quando servono. Prezzi IVA esclusa."
      />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl">
        {pacchettiOre.map((p) => (
          <div class="card flex flex-col gap-2 !p-8">
            <h3 class="text-[1.25rem] font-medium tracking-tight">{p.ore}</h3>
            <div>
              <span class="bignum">{p.price}</span>
            </div>
            <p class="text-[14px]" style="color: var(--color-ink-soft);">{p.rate}</p>
          </div>
        ))}
      </div>
      <p class="mt-6 text-[15px] max-w-3xl text-pretty" style="color: var(--color-ink-muted);">
        Se il lavoro cresce, si passa allo Sprint. Ne parliamo prima, così non firmi la cosa sbagliata.
      </p>
    </div>
  </section>

  <!-- IL METODO -->
  <section class="section" style="background: var(--color-surface);">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="Il metodo"
        title="Cosa è incluso in un mese di Sprint? Il team, il metodo e un rilascio."
        subtitle="Cosa costruire lo decidiamo insieme a inizio mese e lo mettiamo per iscritto. Tu sai cosa arriva, noi sappiamo cosa consegnare."
      />
      <ol class="sprint-timeline sprint-timeline--five">
        {metodo.map((s) => (
          <li class={`sprint-step${s.milestone ? " sprint-step--milestone" : ""}`}>
            <div class="sprint-step-head">
              <span class={`sprint-num${s.milestone ? " sprint-num--milestone" : ""}`}>{s.n}</span>
              <div class="sprint-step-meta">
                <span class="sprint-step-title">{s.title}</span>
              </div>
            </div>
            <p class="sprint-step-body">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- COSTRUTTORE DEL PERCORSO -->
  <section class="section" id="percorso">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="Costruisci il tuo percorso"
        title="Quanto costa un progetto? Lo vedi da solo."
        subtitle="Esempio di partenza: un CRM su misura con dati dei clienti, in 3 mesi di Sprint. Cambia i valori per il tuo caso."
      />
      <PathBuilder client:load />
    </div>
  </section>

  <!-- SICUREZZA -->
  <section class="section" style="background: var(--color-surface);">
    <div class="container-soraia">
      <SectionHeader
        title="Sicurezza: fatta bene sempre, dimostrabile quando serve"
        subtitle="Ogni Sprint costruisce software sicuro, cifratura dei campi sensibili, log di audit e SLA compresi. Compliance & Audit e Pentest non aggiungono sicurezza: aggiungono le prove per chi te la chiede, cioè auditor, enti di certificazione, DPO, soci e clienti."
      />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
        <div class="card flex flex-col gap-4 !p-8">
          <h3 class="text-[1.25rem] font-medium tracking-tight">Sempre incluso in ogni Sprint</h3>
          <ul class="flex flex-col gap-3 text-[15px] list-none p-0 m-0">
            {sicurezzaBase.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="shrink-0 mt-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-[1.375rem] !p-8 flex flex-col gap-4 bg-lines-dark" style="background-color: #1A0820; color: #fff;">
          <h3 class="text-[1.25rem] font-medium tracking-tight" style="color: #fff;">Con Compliance &amp; Audit e Pentest</h3>
          <ul class="flex flex-col gap-3 text-[15px] list-none p-0 m-0">
            {sicurezzaPlus.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="shrink-0 mt-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-violet-200)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                <span style="color: rgba(255,255,255,0.86);">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- REGOLE -->
  <section class="section bg-hero-dark">
    <div class="container-soraia">
      <SectionHeader
        variant="dark"
        title="Regole chiare, uguali per tutti"
        subtitle="Sono scritte nel contratto. Proteggono te quanto noi, ed evitano le discussioni a fine mese."
      />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {regole.map((r) => (
          <div class="dk-card">
            <h3 class="text-[1.0625rem] font-medium tracking-tight" style="color: #fff;">{r.title}</h3>
            <p class="mt-2.5 text-[15px] leading-relaxed text-pretty" style="color: rgba(255,255,255,0.72);">{r.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BANNER BANDO -->
  <section class="section !py-14" style="background: var(--color-surface);">
    <div class="container-soraia flex flex-wrap items-center justify-between gap-6">
      <div class="flex-1 min-w-0" style="flex-basis: 520px;">
        <h3 class="text-[1.5rem] font-medium tracking-tight text-balance">Hai un bando o ti serve un preventivo chiuso?</h3>
        <p class="mt-2 text-[16px] text-pretty" style="color: var(--color-ink-muted);">
          Partiamo dall’Analisi, poi ti diamo un preventivo con l’elenco dei risultati fissato per iscritto.
        </p>
      </div>
      <a href="/bandi" class="btn btn-secondary whitespace-nowrap">Vedi i bandi aperti</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container-soraia max-w-3xl">
      <SectionHeader title="Domande frequenti" />
      <FAQ items={faqs} />
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container-soraia max-w-2xl text-center">
      <h2 class="text-balance" style="font-size: clamp(1.75rem, 3vw + 0.5rem, 2.25rem); line-height: 1.15; letter-spacing: -0.025em; font-weight: 500;">Partiamo da una conversazione, non da un preventivo</h2>
      <p class="mt-4 text-[17px] leading-relaxed text-pretty" style="color: var(--color-ink-muted);">
        Venti minuti per capire il tuo progetto, gli add-on che servono davvero e il percorso. Senza impegno.
      </p>
      <div class="mt-7">
        <a href="/parliamone" class="btn btn-primary">
          20 min con Daniel
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
