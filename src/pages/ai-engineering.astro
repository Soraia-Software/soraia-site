---
import Layout from "~/layouts/Layout.astro";
import SectionHeader from "~/components/SectionHeader.astro";
import SprintRoadmap from "~/components/analisi/SprintRoadmap.tsx";
import "~/styles/prezzi.css";

const title = "AI engineering | Soraia";
const description =
  "Il nostro metodo di sviluppo: sprint iterativi corti, primo agente in produzione in 4 settimane, priorità che si aggiornano sull'uso reale. Tre persone dedicate: Account Manager, Project Manager e AI Engineer.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "AI engineering",
  serviceType: "Sviluppo di agenti IA a sprint iterativi",
  provider: { "@type": "Organization", name: "Soraia" },
  areaServed: "IT",
  description,
  inLanguage: "it-IT",
};
---

<Layout title={title} description={description} lang="it" jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-hero-dark">
    <div class="container-soraia pt-20 md:pt-28 pb-20 md:pb-28 relative z-10">
      <div class="max-w-[900px]" style="color: #fff;">
        <p class="inline-flex items-center gap-2 text-[11px] font-medium tracking-[0.15em] uppercase mb-6 fade-up" style="color: var(--color-violet-200);">
          <span class="w-1 h-1 rounded-full bg-amber"></span>
          Servizi · AI engineering
        </p>

        <h1 style="color: #fff; font-size: clamp(2.5rem, 5vw + 1rem, 4.25rem); line-height: 1.05; letter-spacing: -0.025em; font-weight: 500;" class="text-balance fade-up fade-up-delay-1">
          Dall'idea alla produzione,<br/>uno sprint alla volta.
        </h1>

        <p style="color: rgba(255,255,255,0.78);" class="mt-7 text-[18px] md:text-[19px] leading-relaxed max-w-2xl fade-up fade-up-delay-2 text-pretty">
          Hai le idee chiare su cosa automatizzare. Noi lo costruiamo in <strong style="color: #fff; font-weight: 500;">sprint iterativi corti</strong>: il primo agente gira sui tuoi processi reali in <strong style="color: #fff; font-weight: 500;">quattro settimane</strong>, poi migliora un rilascio alla volta.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row gap-3 fade-up fade-up-delay-3">
          <a href="/parliamone" class="btn !bg-white !text-violet-900 hover:!bg-violet-50">
            20 min con Daniel
            <span class="btn-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span>
          </a>
          <a href="/prezzi" class="btn btn-secondary !bg-transparent !text-white !border-white/25 hover:!bg-white/10 hover:!border-white/40">Vedi i prezzi</a>
        </div>
      </div>
    </div>
  </section>

  <!-- METODOLOGIA -->
  <section class="section bg-white border-t border-line">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="Metodologia"
        title="Come costruiamo i tuoi agenti IA."
        subtitle="<strong>Sprint iterativi corti</strong>: a ogni ciclo l'agente fa già qualcosa di utile in produzione. Niente progetti di sei mesi che finiscono in una demo. Il valore si vede dalla prima settimana."
        align="center"
      />

      <figure class="m-0 mt-8 max-w-[1180px] mx-auto">
        <div class="rounded-2xl bg-ink-50 border border-line px-4 py-6 md:px-8 md:py-8">
          <img src="/agile/sprint.webp" alt="Sprint iterativi: ogni ciclo consegna valore in produzione" loading="lazy" decoding="async" class="w-full h-auto block" />
        </div>
        <figcaption class="mt-3.5 text-[12.5px] text-center" style="color: var(--color-ink-soft);">
          Sprint iterativi: a ogni ciclo l'agente è già in produzione.
        </figcaption>
      </figure>

    </div>
  </section>

  <!-- LA DIFFERENZA -->
  <section class="section pt-0">
    <div class="container-soraia">
      <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-violet-900 via-violet-800 to-violet-700 p-8 md:p-14 text-center" style="color: #fff;">
        <div class="orb orb-violet w-[500px] h-[500px] -top-32 -right-32 opacity-30 float-slow" aria-hidden="true"></div>
        <p class="eyebrow mb-4 relative" style="color: rgba(255,255,255,0.7);">La differenza</p>
        <h2 class="text-balance mx-auto max-w-3xl relative" style="font-size: clamp(1.875rem, 3vw + 0.5rem, 3rem); line-height: 1.08; letter-spacing: -0.025em; font-weight: 500; color: #fff;">
          In 4 settimane sei già in produzione
        </h2>
        <p class="mt-5 text-[17px] md:text-[19px] leading-relaxed text-pretty max-w-2xl mx-auto relative" style="color: rgba(255,255,255,0.82);">
          Molte agenzie, dopo quattro settimane, non ti hanno ancora mandato il preventivo. Con noi, nello stesso mese, il primo rilascio gira già sui tuoi processi reali.
        </p>
      </div>
    </div>
  </section>

  <!-- COME SI ITERA -->
  <section class="section bg-white border-t border-line">
    <div class="container-soraia">
      <SectionHeader
        title="Dopo ogni rilascio, le priorità si aggiornano."
        subtitle="Non pianifichiamo sei mesi di lavoro su carta. Ogni sprint parte da quello che serve davvero, misurato sull'uso reale del rilascio precedente. Costruiamo solo ciò che porta valore, nell'ordine giusto."
        align="left"
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        <div class="card-editorial !p-7 md:!p-8">
          <h3 class="font-medium tracking-tight text-ink-900 mb-2" style="font-size: 1.25rem;">Si rilascia presto</h3>
          <p class="text-[15.5px] text-ink-700 leading-relaxed">Il primo agente va in produzione in quattro settimane. Da lì lavori su qualcosa di reale, non su una presentazione.</p>
        </div>
        <div class="card-editorial !p-7 md:!p-8">
          <h3 class="font-medium tracking-tight text-ink-900 mb-2" style="font-size: 1.25rem;">Si misura l'uso reale</h3>
          <p class="text-[15.5px] text-ink-700 leading-relaxed">Vediamo cosa viene usato, cosa no, dove si inceppa. I dati del rilascio guidano lo sprint successivo, non le opinioni.</p>
        </div>
        <div class="card-editorial !p-7 md:!p-8">
          <h3 class="font-medium tracking-tight text-ink-900 mb-2" style="font-size: 1.25rem;">Si ridefiniscono le priorità</h3>
          <p class="text-[15.5px] text-ink-700 leading-relaxed">Quello che conta di più sale in cima. Quello che non serve più esce. L'obiettivo resta fisso, la rotta si corregge ogni mese.</p>
        </div>
      </div>

      <div class="mt-14 md:mt-20">
        <SprintRoadmap client:load />
      </div>
    </div>
  </section>

  <!-- TRE PERSONE DEDICATE -->
  <section class="section bg-ink-50 border-t border-line">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="Il team"
        title="Tre persone dedicate sul tuo progetto."
        subtitle="Una per ruolo: Account Manager, Project Manager e AI Engineer. Conoscono i tuoi processi e restano le stesse per tutto il percorso. Le ore al mese sono combinate tra i tre ruoli."
        align="left"
      />
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 items-stretch">
        <!-- Account Manager -->
        <div class="card-editorial !p-8 md:!p-10">
          <div class="flex flex-col items-center text-center mb-6">
            <div class="flex items-center justify-center mb-4">
              <img src="/team/daniel-levis.webp?v=4" alt="Daniel Levis" title="Daniel Levis" width="56" height="56" loading="lazy" decoding="async" class="w-14 h-14 rounded-full object-cover ring-2 ring-white shadow-sm" style="object-position: center 20%;" />
              <img src="/team/veronica-pisana.webp?v=4" alt="Veronica Pisana" title="Veronica Pisana" width="56" height="56" loading="lazy" decoding="async" class="w-14 h-14 rounded-full object-cover ring-2 ring-white shadow-sm -ml-3" style="object-position: center 20%;" />
              <img src="/team/paolo-bacchetti.webp?v=4" alt="Paolo Bacchetti" title="Paolo Bacchetti" width="56" height="56" loading="lazy" decoding="async" class="w-14 h-14 rounded-full object-cover ring-2 ring-white shadow-sm -ml-3" style="object-position: center 20%;" />
            </div>
            <h3 class="font-medium tracking-tight" style="font-size: clamp(1.4rem, 2vw, 1.75rem); color: var(--color-brand);">Account Manager</h3>
            <p class="mt-1.5 text-[13px]" style="color: var(--color-ink-soft);">Daniel, Veronica e Paolo</p>
          </div>
          <p class="text-[16px] text-ink-700 leading-relaxed mb-5">Conosce il tuo business e tiene il rapporto nel tempo. Si occupa di:</p>
          <ul class="space-y-3.5 mb-6">
            <li class="flex items-start gap-3">
              <span class="shrink-0 mt-1 inline-flex w-5 h-5 rounded-full bg-violet-50 items-center justify-center"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <span class="text-[15.5px] text-ink-900 leading-snug"><strong class="font-semibold">Obiettivi:</strong> capisce il contesto aziendale e cosa deve cambiare davvero</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0 mt-1 inline-flex w-5 h-5 rounded-full bg-violet-50 items-center justify-center"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <span class="text-[15.5px] text-ink-900 leading-snug"><strong class="font-semibold">Priorità:</strong> decide con te cosa entra nello sprint e cosa aspetta</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0 mt-1 inline-flex w-5 h-5 rounded-full bg-violet-50 items-center justify-center"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <span class="text-[15.5px] text-ink-900 leading-snug"><strong class="font-semibold">Valore:</strong> misura i risultati rispetto all'investimento, mese dopo mese</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0 mt-1 inline-flex w-5 h-5 rounded-full bg-violet-50 items-center justify-center"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <span class="text-[15.5px] text-ink-900 leading-snug"><strong class="font-semibold">Continuità:</strong> lo stesso riferimento prima, durante e dopo il progetto</span>
            </li>
          </ul>
          <p class="text-[15.5px] text-ink-600 leading-relaxed">È la persona con cui parli dalla prima call: traduce gli obiettivi di business in priorità per il team e ti dice con franchezza quando una cosa non conviene farla.</p>
        </div>

        <!-- Project Manager -->
        <div class="card-editorial !p-8 md:!p-10">
          <div class="flex flex-col items-center text-center mb-6">
            <div class="flex items-center justify-center mb-4">
              <img src="/team/eleonora-cogo.webp?v=4" alt="Eleonora Cogo" title="Eleonora Cogo" width="56" height="56" loading="lazy" decoding="async" class="w-14 h-14 rounded-full object-cover ring-2 ring-white shadow-sm" style="object-position: center 20%;" />
              <img src="/team/davide-silvestri.webp?v=4" alt="Davide Silvestri" title="Davide Silvestri" width="56" height="56" loading="lazy" decoding="async" class="w-14 h-14 rounded-full object-cover ring-2 ring-white shadow-sm -ml-3" style="object-position: center 20%;" />
            </div>
            <h3 class="font-medium tracking-tight" style="font-size: clamp(1.4rem, 2vw, 1.75rem); color: var(--color-brand);">Project Manager</h3>
            <p class="mt-1.5 text-[13px]" style="color: var(--color-ink-soft);">Eleonora e Davide</p>
          </div>
          <p class="text-[16px] text-ink-700 leading-relaxed mb-5">Unico riferimento per tutta la fornitura. Garantisce quattro cose:</p>
          <ul class="space-y-3.5 mb-6">
            <li class="flex items-start gap-3">
              <span class="shrink-0 mt-1 inline-flex w-5 h-5 rounded-full bg-violet-50 items-center justify-center"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <span class="text-[15.5px] text-ink-900 leading-snug"><strong class="font-semibold">Comunicazione:</strong> un punto di avanzamento settimanale e un referente sempre raggiungibile</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0 mt-1 inline-flex w-5 h-5 rounded-full bg-violet-50 items-center justify-center"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <span class="text-[15.5px] text-ink-900 leading-snug"><strong class="font-semibold">Budget:</strong> controllo rispetto al perimetro quotato e segnalazione preventiva di ogni scostamento</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0 mt-1 inline-flex w-5 h-5 rounded-full bg-violet-50 items-center justify-center"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <span class="text-[15.5px] text-ink-900 leading-snug"><strong class="font-semibold">Tempistica:</strong> il piano a fasi, sempre aggiornato</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0 mt-1 inline-flex w-5 h-5 rounded-full bg-violet-50 items-center justify-center"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <span class="text-[15.5px] text-ink-900 leading-snug"><strong class="font-semibold">Qualità:</strong> il collaudo di ogni consegna</span>
            </li>
          </ul>
          <p class="text-[15.5px] text-ink-600 leading-relaxed">Tiene il registro delle ore e del lavoro nella dashboard di progetto, a cui hai accesso in ogni momento, e a ogni milestone porta la consegna da verificare: il punto in cui approvi o chiedi correzioni prima di proseguire.</p>
        </div>

        <!-- AI Engineer -->
        <div class="card-editorial !p-8 md:!p-10">
          <div class="flex flex-col items-center text-center mb-6">
            <div class="flex items-center justify-center mb-4">
              <img src="/team/lorenzo-barbaglia.webp?v=4" alt="Lorenzo Barbaglia" title="Lorenzo Barbaglia" width="56" height="56" loading="lazy" decoding="async" class="w-14 h-14 rounded-full object-cover ring-2 ring-white shadow-sm" style="object-position: center 20%;" />
              <img src="/team/martina-rochstein.webp?v=4" alt="Martina Rochstein" title="Martina Rochstein" width="56" height="56" loading="lazy" decoding="async" class="w-14 h-14 rounded-full object-cover ring-2 ring-white shadow-sm -ml-3" style="object-position: center 20%;" />
              <img src="/team/mohamed-mejri.webp?v=4" alt="Mohamed Mejri" title="Mohamed Mejri" width="56" height="56" loading="lazy" decoding="async" class="w-14 h-14 rounded-full object-cover ring-2 ring-white shadow-sm -ml-3" style="object-position: center 20%;" />
              <img src="/team/sebastian-geido.webp?v=4" alt="Sebastian Geido" title="Sebastian Geido" width="56" height="56" loading="lazy" decoding="async" class="w-14 h-14 rounded-full object-cover ring-2 ring-white shadow-sm -ml-3" style="object-position: center 20%;" />
              <img src="/team/narella-petrocco.webp?v=4" alt="Narella Petrocco" title="Narella Petrocco" width="56" height="56" loading="lazy" decoding="async" class="w-14 h-14 rounded-full object-cover ring-2 ring-white shadow-sm -ml-3" style="object-position: center 20%;" />
            </div>
            <h3 class="font-medium tracking-tight" style="font-size: clamp(1.4rem, 2vw, 1.75rem); color: var(--color-brand);">AI Engineer</h3>
            <p class="mt-1.5 text-[13px]" style="color: var(--color-ink-soft);">Lorenzo, Martina, Mohamed, Sebastian e Narella</p>
          </div>
          <p class="text-[16px] text-ink-700 leading-relaxed mb-5">Responsabile dell'intera realizzazione tecnica.</p>
          <ul class="space-y-3.5 mb-6">
            <li class="flex items-start gap-3">
              <span class="shrink-0 mt-1 inline-flex w-5 h-5 rounded-full bg-violet-50 items-center justify-center"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <span class="text-[15.5px] text-ink-900 leading-snug">Progettazione e design UX/UI</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0 mt-1 inline-flex w-5 h-5 rounded-full bg-violet-50 items-center justify-center"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <span class="text-[15.5px] text-ink-900 leading-snug">Sviluppo full-stack e architettura</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0 mt-1 inline-flex w-5 h-5 rounded-full bg-violet-50 items-center justify-center"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <span class="text-[15.5px] text-ink-900 leading-snug">Ottimizzazione degli agenti AI: controlli sull'output, qualità documentale, meno costo di elaborazione</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0 mt-1 inline-flex w-5 h-5 rounded-full bg-violet-50 items-center justify-center"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <span class="text-[15.5px] text-ink-900 leading-snug">Quality assurance e test massivi di sforzo</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0 mt-1 inline-flex w-5 h-5 rounded-full bg-violet-50 items-center justify-center"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <span class="text-[15.5px] text-ink-900 leading-snug">DevOps in ambienti sicuri, deployment e rilasci in produzione controllati</span>
            </li>
          </ul>
          <p class="text-[15.5px] text-ink-600 leading-relaxed">L'ottimizzazione degli agenti non è un dettaglio: si mette a punto il sistema perché ometta l'informazione che non possiede anziché stimarla, e si prosegue fino al collaudo sui casi reali portati dall'uso.</p>
        </div>
      </div>
      <p class="mt-7 text-[15.5px]" style="color: var(--color-ink-soft);">
        Il modello e i livelli li trovi nei <a href="/prezzi" style="color: var(--color-brand); font-weight: 600;">prezzi</a>, a partire da 5.000 euro al mese.
      </p>
    </div>
  </section>

  <!-- PORTALE CLIENTE -->
  <section class="section bg-white border-t border-line">
    <div class="container-soraia">
      <div class="max-w-2xl mb-10">
        <p class="eyebrow mb-4">Trasparenza</p>
        <h2 class="text-balance" style="font-size: clamp(1.875rem, 3vw + 0.5rem, 2.5rem); line-height: 1.1; letter-spacing: -0.025em; font-weight: 500;">Il portale cliente, in tempo reale</h2>
        <p class="mt-5 text-[17px] md:text-[18px] text-ink-700 leading-relaxed text-pretty">
          Durante gli Sprint hai questo portale: i ticket in lavorazione, l'avanzamento dello Sprint, cosa è stato rilasciato. Niente scatola nera, niente report da chiedere. Provalo qui sotto, sono dati di esempio.
        </p>
      </div>
      <div class="portal-embed">
        <div class="portal-embed__bar">
          <span class="portal-embed__dot" style="background:#ff5f57;"></span>
          <span class="portal-embed__dot" style="background:#febc2e;"></span>
          <span class="portal-embed__dot" style="background:#28c840;"></span>
          <span class="portal-embed__url">Portale cliente · Nordica HR (demo)</span>
          <button type="button" id="portalExpand" class="portal-embed__expand" aria-label="Apri a schermo intero">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
          </button>
        </div>
        <iframe id="portalFrame" src="/demo-portale?embed=1" title="Portale cliente Soraia, demo interattiva" loading="lazy"></iframe>
      </div>
    </div>
    <script is:inline>
      (function () {
        var b = document.getElementById("portalExpand");
        if (b) b.addEventListener("click", function () { window.open("/demo-portale", "_blank"); });
      })();
    </script>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container-soraia text-center max-w-2xl">
      <h2 class="text-balance" style="font-size: clamp(1.75rem, 3vw + 0.5rem, 2.25rem); line-height: 1.15; letter-spacing: -0.025em; font-weight: 500;">Partiamo da una conversazione, non da un preventivo</h2>
      <p class="mt-5 text-[17px] text-ink-700 leading-relaxed text-pretty">
        Raccontaci il processo che vuoi automatizzare. In 20 minuti capiamo insieme se ha senso e da quale sprint conviene partire.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/parliamone" class="btn btn-primary">
          20 min con Daniel
          <span class="btn-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/analisi-processi" class="btn btn-secondary">Non so da dove partire</a>
      </div>
    </div>
  </section>
</Layout>
