---
import Layout from "~/layouts/Layout.astro";
import SectionHeader from "~/components/SectionHeader.astro";
import "~/styles/prezzi.css";

const title = "AI engineering | Soraia";
const description =
  "Il nostro metodo di sviluppo: sprint iterativi corti, primo agente in produzione in 4 settimane, priorità che si aggiornano sull'uso reale. Due figure dedicate (Project Manager e AI Engineer).";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "AI engineering",
  serviceType: "Sviluppo di agenti IA a sprint iterativi",
  provider: { "@type": "Organization", name: "Soraia" },
  areaServed: "IT",
  description,
  inLanguage: "it-IT",
};
---

<Layout title={title} description={description} lang="it" jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-violet-mesh">
    <div class="orb orb-violet w-[500px] h-[500px] -top-32 -right-20 opacity-40 float-slow" aria-hidden="true"></div>
    <div class="container-soraia pt-16 md:pt-24 pb-14 md:pb-20 relative z-10 max-w-3xl">
      <p class="eyebrow mb-5">AI engineering</p>
      <h1 class="text-[2.5rem] sm:text-[3.25rem] md:text-[3.75rem] font-semibold tracking-tight text-ink-900 leading-[1.04] text-balance">
        Dall'idea alla produzione, uno sprint alla volta.
      </h1>
      <p class="mt-6 text-[18px] md:text-[20px] text-ink-700 leading-relaxed text-pretty max-w-2xl">
        Avete le idee chiare su cosa automatizzare. Noi lo costruiamo in sprint iterativi corti: il primo agente gira sui vostri processi reali in quattro settimane, poi migliora un rilascio alla volta.
      </p>
      <div class="mt-9 flex flex-col sm:flex-row gap-3">
        <a href="/parliamone" class="btn btn-primary">
          20 min con Daniel
          <span class="btn-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/prezzi" class="btn btn-secondary">Vedi i prezzi</a>
      </div>
    </div>
  </section>

  <!-- METODOLOGIA -->
  <section class="section bg-white border-t border-line">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="Metodologia"
        title="Come costruiamo i vostri agenti IA."
        subtitle="<strong>Sprint iterativi corti</strong>: a ogni ciclo l'agente fa già qualcosa di utile in produzione. Niente progetti di sei mesi che finiscono in una demo. Il valore si vede dalla prima settimana."
        align="center"
      />

      <figure class="m-0 mt-8 max-w-[1180px] mx-auto">
        <div class="rounded-2xl bg-ink-50 border border-line px-4 py-6 md:px-8 md:py-8">
          <img src="/agile/sprint.webp" alt="Sprint iterativi: ogni ciclo consegna valore in produzione" loading="lazy" decoding="async" class="w-full h-auto block" />
        </div>
        <figcaption class="mt-3.5 text-[12.5px] text-center" style="color: var(--color-ink-soft);">
          Sprint iterativi: a ogni ciclo l'agente è già in produzione.
        </figcaption>
      </figure>

      <div class="mt-14 md:mt-16 max-w-6xl mx-auto">
        <ol class="sprint-timeline">
          <li class="sprint-step">
            <div class="sprint-step-head">
              <span class="sprint-num">1</span>
              <div class="sprint-step-meta">
                <p class="sprint-step-tag">Settimana 1</p>
                <p class="sprint-step-title">Discovery + baseline</p>
              </div>
            </div>
            <p class="sprint-step-body">Cronometriamo il processo con il vostro team. Fissiamo un <strong>metric primario unico</strong> (es. ore a settimana recuperate). Senza baseline, niente garanzia.</p>
          </li>
          <li class="sprint-step">
            <div class="sprint-step-head">
              <span class="sprint-num">2</span>
              <div class="sprint-step-meta">
                <p class="sprint-step-tag">Settimane 2-3</p>
                <p class="sprint-step-title">Build dell'agente</p>
              </div>
            </div>
            <p class="sprint-step-body">Prompt engineering, integrazione con i vostri sistemi (CRM, ATS, gestionali), regole di escalation, audit log. Review settimanali con il team operativo.</p>
          </li>
          <li class="sprint-step">
            <div class="sprint-step-head">
              <span class="sprint-num">3</span>
              <div class="sprint-step-meta">
                <p class="sprint-step-tag">Settimana 4</p>
                <p class="sprint-step-title">Shadow mode + training</p>
              </div>
            </div>
            <p class="sprint-step-body">L'agente lavora in parallelo al team, senza prendere ancora decisioni da solo. Confronto degli output, fine-tuning sui criteri, formazione delle persone.</p>
          </li>
          <li class="sprint-step sprint-step--milestone">
            <div class="sprint-step-head">
              <span class="sprint-num sprint-num--milestone">4</span>
              <div class="sprint-step-meta">
                <p class="sprint-step-tag">Go-live + 30 gg</p>
                <p class="sprint-step-title">Hypercare e misurazione</p>
              </div>
            </div>
            <p class="sprint-step-body">L'agente passa in produzione. Monitoraggio attivo per 30 giorni, fix immediati sui casi limite. Al giorno 30, <strong>misurazione finale vs baseline</strong>. Se non avete recuperato le ore promesse, non pagate lo sprint.</p>
          </li>
        </ol>

        <div class="mt-12 flex justify-center">
          <div class="inline-flex items-center gap-2.5 px-5 py-3 rounded-full text-[13px] font-medium" style="background: var(--color-brand-soft); color: var(--color-brand); border: 1px solid var(--color-violet-200);">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span><strong>4 settimane</strong> al primo agente live · iterazioni mensili dopo il go-live</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LA DIFFERENZA -->
  <section class="section pt-0">
    <div class="container-soraia">
      <div class="rounded-3xl p-8 md:p-14 text-center" style="background: var(--color-brand); color: #fff;">
        <p class="eyebrow mb-4" style="color: rgba(255,255,255,0.7);">La differenza</p>
        <h2 class="text-balance mx-auto max-w-3xl" style="font-size: clamp(1.875rem, 3vw + 0.5rem, 3rem); line-height: 1.08; letter-spacing: -0.025em; font-weight: 500; color: #fff;">
          In 4 settimane siete già in produzione
        </h2>
        <p class="mt-5 text-[17px] md:text-[19px] leading-relaxed text-pretty max-w-2xl mx-auto" style="color: rgba(255,255,255,0.82);">
          Molte agenzie, dopo quattro settimane, non vi hanno ancora mandato il preventivo. Con noi, nello stesso mese, il primo rilascio gira già sui vostri processi reali.
        </p>
      </div>
    </div>
  </section>

  <!-- COME SI ITERA -->
  <section class="section bg-white border-t border-line">
    <div class="container-soraia">
      <SectionHeader
        title="Dopo ogni rilascio, le priorità si aggiornano."
        subtitle="Non pianifichiamo sei mesi di lavoro su carta. Ogni sprint parte da quello che serve davvero, misurato sull'uso reale del rilascio precedente. Costruiamo solo ciò che porta valore, nell'ordine giusto."
        align="left"
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        <div class="card-editorial !p-7 md:!p-8">
          <h3 class="font-semibold tracking-tight text-ink-900 mb-2" style="font-size: 1.25rem;">Si rilascia presto</h3>
          <p class="text-[15.5px] text-ink-700 leading-relaxed">Il primo agente va in produzione in quattro settimane. Da lì lavorate su qualcosa di reale, non su una presentazione.</p>
        </div>
        <div class="card-editorial !p-7 md:!p-8">
          <h3 class="font-semibold tracking-tight text-ink-900 mb-2" style="font-size: 1.25rem;">Si misura l'uso reale</h3>
          <p class="text-[15.5px] text-ink-700 leading-relaxed">Vediamo cosa viene usato, cosa no, dove si inceppa. I dati del rilascio guidano lo sprint successivo, non le opinioni.</p>
        </div>
        <div class="card-editorial !p-7 md:!p-8">
          <h3 class="font-semibold tracking-tight text-ink-900 mb-2" style="font-size: 1.25rem;">Si ridefiniscono le priorità</h3>
          <p class="text-[15.5px] text-ink-700 leading-relaxed">Quello che conta di più sale in cima. Quello che non serve più esce. L'obiettivo resta fisso, la rotta si corregge ogni mese.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DUE FIGURE DEDICATE -->
  <section class="section bg-ink-50 border-t border-line">
    <div class="container-soraia">
      <SectionHeader
        eyebrow="Il team"
        title="Due figure dedicate sul vostro progetto."
        subtitle="Non un team che ruota su dieci clienti. Due persone che conoscono i vostri processi e restano le stesse per tutto il percorso. Le ore al mese sono combinate tra le due figure."
        align="left"
      />
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
        <div class="card-editorial !p-8 md:!p-10">
          <h3 class="font-semibold tracking-tight text-ink-900 mb-3" style="font-size: clamp(1.4rem, 2vw, 1.75rem);">Project Manager</h3>
          <p class="text-[16px] text-ink-700 leading-relaxed">Il vostro unico punto di contatto. Tiene il ritmo degli sprint, traduce gli obiettivi in attività, vi tiene allineati su avanzamento e priorità. Nessun rimpallo, nessuna scatola nera.</p>
        </div>
        <div class="card-editorial !p-8 md:!p-10">
          <h3 class="font-semibold tracking-tight text-ink-900 mb-3" style="font-size: clamp(1.4rem, 2vw, 1.75rem);">AI Engineer</h3>
          <p class="text-[16px] text-ink-700 leading-relaxed">Costruisce gli agenti e li integra con i vostri sistemi. Prompt engineering, regole di escalation, audit log, misurazione. La parte tecnica, gestita da chi la fa ogni giorno.</p>
        </div>
      </div>
      <p class="mt-7 text-[15.5px]" style="color: var(--color-ink-soft);">
        Il modello e le ore mensili li trovate nei <a href="/prezzi" style="color: var(--color-brand); font-weight: 600;">prezzi</a>, a partire da 3.000 euro al mese.
      </p>
    </div>
  </section>

  <!-- PORTALE CLIENTE -->
  <section class="section bg-white border-t border-line">
    <div class="container-soraia">
      <div class="max-w-2xl mb-10">
        <p class="eyebrow mb-4">Trasparenza</p>
        <h2 class="text-balance" style="font-size: clamp(1.875rem, 3vw + 0.5rem, 2.5rem); line-height: 1.1; letter-spacing: -0.025em; font-weight: 500;">Il portale cliente, in tempo reale</h2>
        <p class="mt-5 text-[17px] md:text-[18px] text-ink-700 leading-relaxed text-pretty">
          Durante gli sprint avete questo portale: i ticket in lavorazione, le ore per sprint e per persona, l'avanzamento del progetto. Niente scatola nera, niente report da chiedere. Provatelo qui sotto, sono dati di esempio.
        </p>
      </div>
      <div class="portal-embed">
        <div class="portal-embed__bar">
          <span class="portal-embed__dot" style="background:#ff5f57;"></span>
          <span class="portal-embed__dot" style="background:#febc2e;"></span>
          <span class="portal-embed__dot" style="background:#28c840;"></span>
          <span class="portal-embed__url">Portale cliente · Nordica HR (demo)</span>
          <button type="button" id="portalExpand" class="portal-embed__expand" aria-label="Apri a schermo intero">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
          </button>
        </div>
        <iframe id="portalFrame" src="/demo-portale?embed=1" title="Portale cliente Soraia, demo interattiva" loading="lazy"></iframe>
      </div>
    </div>
    <script is:inline>
      (function () {
        var b = document.getElementById("portalExpand");
        if (b) b.addEventListener("click", function () { window.open("/demo-portale", "_blank"); });
      })();
    </script>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container-soraia text-center max-w-2xl">
      <h2 class="text-balance" style="font-size: clamp(1.75rem, 3vw + 0.5rem, 2.25rem); line-height: 1.15; letter-spacing: -0.025em; font-weight: 500;">Partiamo da una conversazione, non da un preventivo</h2>
      <p class="mt-5 text-[17px] text-ink-700 leading-relaxed text-pretty">
        Raccontateci il processo che volete automatizzare. In 20 minuti capiamo insieme se ha senso e da quale sprint conviene partire.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/parliamone" class="btn btn-primary">
          Candida il tuo progetto
          <span class="btn-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/analisi-processi" class="btn btn-secondary">Non so da dove partire</a>
      </div>
    </div>
  </section>
</Layout>
