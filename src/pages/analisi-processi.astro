---
import Layout from "~/layouts/Layout.astro";
import AnalisiProcessi from "~/components/analisi/AnalisiProcessi.tsx";
import { NOINDEX } from "~/components/analisi/data";
import "~/styles/analisi.css";

const title = "Analisi dei processi aziendali per PMI | Soraia";
const description =
  "Veniamo in azienda, intervistiamo chi fa il lavoro e mappiamo i flussi: ne escono priorità e piano d'azione per automazione e agenti IA. Da 3.000 €.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Analisi dei processi",
  provider: { "@type": "Organization", name: "Soraia" },
  areaServed: "IT",
  description,
  inLanguage: "it-IT",
  offers: {
    "@type": "Offer",
    name: "Analisi dei processi",
    price: "3000",
    priceCurrency: "EUR",
    description: "Fino a 10 interviste in azienda, mappa dei flussi, priorità e piano d'azione. IVA esclusa.",
  },
};
---

<Layout
  title={title}
  description={description}
  lang="it"
  jsonLd={jsonLd}
  noindex={NOINDEX}
>
  <AnalisiProcessi client:load />
</Layout>
